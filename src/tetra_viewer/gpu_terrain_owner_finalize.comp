#version 450
// Writes the native SceneVertex header after the owner-count scan.  Emission
// is skipped entirely when this fail-closed preflight rejects the candidate.
layout(std430,binding=0) readonly buffer Counts {uint values[];} counts;
layout(std430,binding=1) readonly buffer Offsets {uint values[];} offsets;
layout(std430,binding=2) readonly buffer Status {uint words[];} status;
layout(std430,binding=3) buffer Vertices {uint words[];} vertices;
layout(push_constant) uniform Parameters {uint owner_count;uint vertex_capacity;} parameters;
layout(local_size_x=1) in;
void main(){if(parameters.owner_count==0u||status.words[1u]!=0u){vertices.words[1u]=1u;return;}uint t=offsets.values[parameters.owner_count-1u]+counts.values[parameters.owner_count-1u];if(t==0u||t>parameters.vertex_capacity/12u){vertices.words[1u]=1u;return;}vertices.words[0u]=t*12u;vertices.words[2u]=t;}
