vec3 integrate_shadowed_direct_radiance(vec3 origin,vec3 direction,
                                        float maximum_distance,
                                        out float maximum_shadow_loss,
                                        out vec3 unshadowed_direct) {
  maximum_shadow_loss=0.0;
  unshadowed_direct=vec3(0.0);
  float begin,end;
  if(!medium_segment(origin,direction,begin,end)||maximum_distance<=begin)
    return vec3(0.0);
  end=min(end,maximum_distance);
  const int steps=32;
  const float segment_length=end-begin;
  const vec3 sun_direction=normalize(atmosphere.sun_direction_exposure.xyz);
  const float phase_cosine=dot(direction,sun_direction);
  const float phase_rayleigh=rayleigh_phase(phase_cosine);
  const float phase_mie=mie_phase(phase_cosine);
  vec3 shadowed_direct=vec3(0.0);
  vec3 transmittance=vec3(1.0);
  const int shadow_integrator=int(atmosphere.reserved1.w+0.5);
  // Preserve the qualified fixed path exactly as the comparison control.
  if(shadow_integrator==0){
  for(int index=0;index<steps;++index){
    const float interval_begin=float(index)/float(steps);
    const float interval_end=float(index+1)/float(steps);
    const float distance_begin=begin+
        segment_length*interval_begin*interval_begin;
    const float distance_end=begin+
        segment_length*interval_end*interval_end;
    const float step_length=distance_end-distance_begin;
    const float distance=0.5*(distance_begin+distance_end);
    const vec3 point=origin+direction*distance;
    const vec3 density=densities(length(point)-ground_radius());
    const vec3 local_extinction=extinction(density);
    const vec3 segment_transmittance=exp(-local_extinction*step_length);
    const vec3 direct_source=(
        atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
        atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
        lookup_transmittance(point,sun_direction)*
        atmosphere.solar_absorption_peak.rgb;
    const float direct_visibility=atmosphere_sun_visibility(point);
    const float shadow_loss=1.0-direct_visibility;
    maximum_shadow_loss=max(maximum_shadow_loss,shadow_loss);
    const vec3 integral=(vec3(1.0)-segment_transmittance)/
        max(local_extinction,vec3(1.0e-9));
    unshadowed_direct+=transmittance*direct_source*integral;
    shadowed_direct+=transmittance*direct_source*direct_visibility*integral;
    transmittance*=segment_transmittance;
  }
  return shadowed_direct;
  }
  // The final faithful compositor samples a horizon ray in radial-altitude
  // space. The former cache sampled the same ray in squared camera-distance
  // space. Around a low sun those two grids do not overlap: the terrain query
  // can report a fully occluded ray while every radiometric sample lands where
  // the direct source has underflowed. Accumulate the shadowed numerator on
  // exactly the compositor's 16+16 altitude intervals so its bounded
  // visibility ratio describes the same light. Only visibility
  // discontinuities receive additional substeps.
  const float closest=clamp(-dot(origin,direction),begin,end);
  const float closest_radius=length(origin+direction*closest);
  const float closest_altitude=max(closest_radius-ground_radius(),0.0);
  const float mie_scale=max(atmosphere.absorption_mie_scale.w,1.0);
  const float altitude_power=mix(2.0,5.0,
      exp(-closest_altitude/(4.0*mie_scale)));
  const int half_steps=steps/2;
  for(int index=0;index<steps;++index){
    const bool before=index<half_steps;
    const int local_index=before?index:index-half_steps;
    const float u0=float(local_index)/float(half_steps);
    const float u1=float(local_index+1)/float(half_steps);
    const float side_distance=before?begin:end;
    const float side_altitude=max(
        length(origin+direction*side_distance)-ground_radius(),
        closest_altitude);
    const float altitude_begin=mix(closest_altitude,side_altitude,
        pow(before?1.0-u0:u0,altitude_power));
    const float altitude_end=mix(closest_altitude,side_altitude,
        pow(before?1.0-u1:u1,altitude_power));
    const float offset_begin=sqrt(max(
        (ground_radius()+altitude_begin)*(ground_radius()+altitude_begin)-
        closest_radius*closest_radius,0.0));
    const float offset_end=sqrt(max(
        (ground_radius()+altitude_end)*(ground_radius()+altitude_end)-
        closest_radius*closest_radius,0.0));
    const float base_begin=closest+(before?-offset_begin:offset_begin);
    const float base_end=closest+(before?-offset_end:offset_end);
    if(base_end<=base_begin)continue;
    const float base_middle=0.5*(base_begin+base_end);
    const float visibility_begin=atmosphere_sun_visibility(
        origin+direction*base_begin);
    const float visibility_middle=atmosphere_sun_visibility(
        origin+direction*base_middle);
    const float visibility_end=atmosphere_sun_visibility(
        origin+direction*base_end);
    const float visibility_range=max(visibility_begin,
        max(visibility_middle,visibility_end))-min(visibility_begin,
        min(visibility_middle,visibility_end));
    const float minmax_visibility=shadow_integrator==5?
        atmosphere_epipolar_range_visibility(origin,direction,base_begin,
                                              base_end):
        ((shadow_integrator==2||shadow_integrator==4)?
        atmosphere_minmax_range_visibility(origin,direction,base_begin,
                                            base_end):-2.0);
    const int hierarchy_substeps=minmax_visibility<=-3.0?
        clamp(int(round(-minmax_visibility))-2,2,32):1;
    int substeps=hierarchy_substeps>1?hierarchy_substeps:
        (visibility_range>0.02?8:1);
    if((shadow_integrator==2||shadow_integrator==4||shadow_integrator==5)&&
       minmax_visibility>-2.5&&minmax_visibility<-1.5)substeps=8;
    if(shadow_integrator==3)substeps=32;
    for(int substep=0;substep<32;++substep){
      if(substep>=substeps)break;
      const float sub_begin=mix(base_begin,base_end,
          float(substep)/float(substeps));
      const float sub_end=mix(base_begin,base_end,
          float(substep+1)/float(substeps));
      const float step_length=sub_end-sub_begin;
      const float distance=0.5*(sub_begin+sub_end);
      const vec3 point=origin+direction*distance;
      const vec3 density=densities(length(point)-ground_radius());
      const vec3 local_extinction=extinction(density);
      const vec3 segment_transmittance=exp(-local_extinction*step_length);
      const vec3 direct_source=(
          atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
          atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
          lookup_transmittance(point,sun_direction)*
          atmosphere.solar_absorption_peak.rgb;
      float resolved_visibility=substeps==1&&minmax_visibility>=0.0?
          minmax_visibility:-1.0;
      if(shadow_integrator==5&&minmax_visibility<=-3.0)
        resolved_visibility=atmosphere_epipolar_range_visibility(
            origin,direction,sub_begin,sub_end);
      const float direct_visibility=resolved_visibility>=0.0?
          resolved_visibility:atmosphere_sun_visibility(point);
      const float shadow_loss=1.0-direct_visibility;
      maximum_shadow_loss=max(maximum_shadow_loss,shadow_loss);
      const vec3 integral=(vec3(1.0)-segment_transmittance)/
          max(local_extinction,vec3(1.0e-9));
      unshadowed_direct+=transmittance*direct_source*integral;
      shadowed_direct+=transmittance*direct_source*direct_visibility*integral;
      transmittance*=segment_transmittance;
    }
  }
  return shadowed_direct;
}
