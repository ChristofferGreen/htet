layout(std140,set=0,binding=5) uniform Atmosphere {
  vec4 rayleigh_ground_radius;
  vec4 mie_scattering_top_radius;
  vec4 mie_absorption_rayleigh_scale;
  vec4 absorption_mie_scale;
  vec4 ground_albedo_mie_anisotropy;
  vec4 solar_absorption_peak;
  vec4 profile_and_mode;
  vec4 camera_position_near;
  vec4 camera_right_tangent_x;
  vec4 camera_down_tangent_y;
  vec4 camera_forward_maximum_distance;
  vec4 sun_direction_exposure;
  vec4 reserved0;
  vec4 reserved1;
  vec4 reserved2;
  vec4 reserved3;
  vec4 previous_camera_position_near;
  vec4 previous_camera_right_tangent_x;
  vec4 previous_camera_down_tangent_y;
  vec4 previous_camera_forward;
  // x = global history validity, y = previous generation bits,
  // z = temporal blend, w = reserved.
  vec4 temporal_control;
  // xy = active scene extent, zw = active reconstructed-screen extent.
  vec4 render_resolution;
} atmosphere;

layout(std140,set=0,binding=7) uniform ShadowCascades {
  mat4 shadow_matrices[5];
  vec4 shadow_splits;
  vec4 local_depth_spans;
  vec4 atmosphere_shadow_metadata;
  vec4 epipolar_metadata;
} shadow_cascades;

layout(push_constant) uniform DispatchMode {
  uint mode;
  uint reserved0;
  uint reserved1;
  uint reserved2;
} dispatch_mode;

ivec2 active_scene_size() {
  return max(ivec2(atmosphere.render_resolution.xy+0.5),ivec2(1));
}

ivec2 active_screen_size() {
  return max(ivec2(atmosphere.render_resolution.zw+0.5),ivec2(1));
}

const float PI=3.14159265358979323846;

float ground_radius(){return atmosphere.rayleigh_ground_radius.w;}
float top_radius(){return atmosphere.mie_scattering_top_radius.w;}
float atmosphere_height(){return top_radius()-ground_radius();}

vec2 sphere_roots(vec3 origin,vec3 direction,float radius) {
  const float b=dot(origin,direction);
  // Avoid subtracting two planet-radius-squared values to recover a few
  // metres of altitude. That cancellation quantizes the tangent decision in
  // float and appears as horizontal sky bands near the horizon.
  const float radial_distance=length(origin);
  const float c=(radial_distance-radius)*(radial_distance+radius);
  const float discriminant=b*b-c;
  if(discriminant<0.0)return vec2(1.0,-1.0);
  const float root=sqrt(max(discriminant,0.0));
  return vec2(-b-root,-b+root);
}

bool outer_medium_segment(vec3 origin,vec3 direction,
                          out float begin,out float end) {
  const vec2 outer=sphere_roots(origin,direction,top_radius());
  if(outer.y<0.0)return false;
  begin=max(0.0,outer.x);
  end=outer.y;
  return end>begin;
}

bool medium_segment(vec3 origin,vec3 direction,out float begin,out float end) {
  if(!outer_medium_segment(origin,direction,begin,end))return false;
  const float radial_distance=length(origin);
  if(radial_distance<ground_radius()){
    const vec2 ground=sphere_roots(origin,direction,ground_radius());
    if(ground.y>=0.0)begin=max(begin,ground.y);
  }else{
    // Classify a ground hit from altitude and horizon angle before solving its
    // distance. b*b-c loses the complete discriminant for metre-scale tangent
    // rays around a compact planet because both terms are about 4e5 in float.
    const float altitude=radial_distance-ground_radius();
    const float radial_cosine=dot(origin/radial_distance,direction);
    const float horizon_sine_squared=max(0.0,
        altitude*(radial_distance+ground_radius())/
            (radial_distance*radial_distance));
    const float cosine_squared=radial_cosine*radial_cosine;
    if(radial_cosine<0.0&&cosine_squared>
       horizon_sine_squared*(1.0+2.0e-6)){
      const float root=radial_distance*(-radial_cosine-
          sqrt(max(cosine_squared-horizon_sine_squared,0.0)));
      if(root>begin+0.01)end=min(end,root);
    }
  }
  return end>begin;
}

float sunlight_visibility(vec3 point,vec3 direction) {
  const float radial_distance=length(point);
  if(radial_distance<=ground_radius())return 0.0;
  const float cosine_angle=dot(point/radial_distance,direction);
  const float altitude=radial_distance-ground_radius();
  const float horizon_sine_squared=max(0.0,
      altitude*(radial_distance+ground_radius())/
          (radial_distance*radial_distance));
  const float horizon_cosine=-sqrt(horizon_sine_squared);
  const float angular_width=max(atmosphere.profile_and_mode.z,1.0e-5);
  const float cosine_width=max(sin(angular_width),1.0e-5);
  return smoothstep(horizon_cosine-cosine_width,
                    horizon_cosine+cosine_width,cosine_angle);
}

vec3 densities(float altitude) {
  if(altitude<0.0||altitude>atmosphere_height())return vec3(0.0);
  const float rayleigh=exp(-altitude/atmosphere.mie_absorption_rayleigh_scale.w);
  const float mie=exp(-altitude/atmosphere.absorption_mie_scale.w);
  const float absorption=max(0.0,1.0-
      abs(altitude-atmosphere.solar_absorption_peak.w)/
          atmosphere.profile_and_mode.x);
  return vec3(rayleigh,mie,absorption);
}

vec3 extinction(vec3 density) {
  return atmosphere.rayleigh_ground_radius.rgb*density.x+
      (atmosphere.mie_scattering_top_radius.rgb+
       atmosphere.mie_absorption_rayleigh_scale.rgb)*density.y+
      atmosphere.absorption_mie_scale.rgb*density.z;
}

vec3 integrate_transmittance(vec3 origin,vec3 direction,float distance,
                             int steps,bool concentrate_near_planet) {
  if(distance<=0.0)return vec3(1.0);
  vec3 optical_depth=vec3(0.0);
  const float closest_fraction=clamp(
      -dot(origin,direction)/distance,0.0,1.0);
  for(int index=0;index<128;++index){
    if(index>=steps)break;
    float fraction_begin=float(index)/float(steps);
    float fraction_end=float(index+1)/float(steps);
    if(concentrate_near_planet){
      if(closest_fraction<=1.0e-6){
        fraction_begin*=fraction_begin;
        fraction_end*=fraction_end;
      }else if(closest_fraction>=1.0-1.0e-6){
        fraction_begin=1.0-(1.0-fraction_begin)*(1.0-fraction_begin);
        fraction_end=1.0-(1.0-fraction_end)*(1.0-fraction_end);
      }else{
        const int lower_steps=max(steps/2,1);
        const int upper_steps=max(steps-lower_steps,1);
        if(index<lower_steps){
          const float lower_begin=float(index)/float(lower_steps);
          const float lower_end=float(index+1)/float(lower_steps);
          fraction_begin=closest_fraction*(1.0-
              (1.0-lower_begin)*(1.0-lower_begin));
          fraction_end=closest_fraction*(1.0-
              (1.0-lower_end)*(1.0-lower_end));
        }else{
          const float upper_begin=float(index-lower_steps)/float(upper_steps);
          const float upper_end=float(index-lower_steps+1)/float(upper_steps);
          fraction_begin=closest_fraction+
              (1.0-closest_fraction)*upper_begin*upper_begin;
          fraction_end=closest_fraction+
              (1.0-closest_fraction)*upper_end*upper_end;
        }
      }
    }
    const float distance_begin=distance*fraction_begin;
    const float distance_end=distance*fraction_end;
    const float step_length=distance_end-distance_begin;
    const vec3 point=origin+direction*
        (0.5*(distance_begin+distance_end));
    optical_depth+=extinction(densities(length(point)-ground_radius()))*
        step_length;
  }
  return exp(-max(optical_depth,vec3(0.0)));
}

vec4 checked_lut_value(vec3 value,float maximum_value) {
  const bool finite=!(any(isnan(value))||any(isinf(value)));
  const bool in_range=finite&&all(greaterThanEqual(value,vec3(0.0)))&&
      all(lessThanEqual(value,vec3(maximum_value)));
  return vec4(in_range?value:clamp(finite?value:vec3(0.0),
                                  vec3(0.0),vec3(maximum_value)),
              in_range?1.0:0.0);
}

bool faithful_transport(){return atmosphere.reserved1.y>0.5;}
bool numeric_probe(){return int(floor(atmosphere.reserved1.z/10.0))%10==1;}
int shadow_filter_mode(){return int(mod(atmosphere.reserved1.z,10.0)+0.5);}
bool dynamic_sun(){return atmosphere.reserved1.z>=99.5;}
int dynamic_sun_shadow_phase(){
  return int(floor(atmosphere.reserved1.z/1000.0))-1;
}
float atmosphere_comparison_bias_world(){
  return max(shadow_cascades.epipolar_metadata.z,0.0);
}

uint shadow_minmax_level_offset(uint level,uint base_resolution) {
  uint offset=0U;
  uint size=base_resolution;
  for(uint current=0U;current<level;++current){
    offset+=size*size;
    size=max(1U,(size+1U)/2U);
  }
  return offset;
}

uint shadow_minmax_level_size(uint level,uint base_resolution) {
  uint size=base_resolution;
  for(uint current=0U;current<level;++current)
    size=max(1U,(size+1U)/2U);
  return size;
}

vec2 shadow_minmax_load(uint level,ivec2 coordinate,uint base_resolution) {
  const uint size=shadow_minmax_level_size(level,base_resolution);
  coordinate=clamp(coordinate,ivec2(0),ivec2(int(size)-1));
  return uintBitsToFloat(atmosphere_shadow_minmax.ranges[
      shadow_minmax_level_offset(level,base_resolution)+
      uint(coordinate.y)*size+uint(coordinate.x)]);
}

uint epipolar_level_offset(uint level,uint radial_resolution,
                           uint angular_rows) {
  uint offset=0U;
  uint width=radial_resolution;
  for(uint current=0U;current<level;++current){
    offset+=width*angular_rows;
    width=max(1U,(width+1U)/2U);
  }
  return offset;
}

uint epipolar_level_width(uint level,uint radial_resolution) {
  uint width=radial_resolution;
  for(uint current=0U;current<level;++current)
    width=max(1U,(width+1U)/2U);
  return width;
}

vec2 epipolar_minmax_load(uint level,int radial,int row,
                          uint radial_resolution,uint angular_rows) {
  const uint width=epipolar_level_width(level,radial_resolution);
  radial=clamp(radial,0,int(width)-1);
  row=(row%int(angular_rows)+int(angular_rows))%int(angular_rows);
  return uintBitsToFloat(atmosphere_shadow_minmax.ranges[
      epipolar_level_offset(level,radial_resolution,angular_rows)+
      uint(row)*width+uint(radial)]);
}

float epipolar_radius_to_guarded_square(vec2 origin,vec2 direction) {
  float distance=1.0e20;
  if(direction.x>1.0e-7)distance=min(distance,(0.94-origin.x)/direction.x);
  if(direction.x<-1.0e-7)distance=min(distance,(-0.94-origin.x)/direction.x);
  if(direction.y>1.0e-7)distance=min(distance,(0.94-origin.y)/direction.y);
  if(direction.y<-1.0e-7)distance=min(distance,(-0.94-origin.y)/direction.y);
  return max(distance,0.0);
}

float epipolar_blocker_angle(float projected_radius,float blocker_depth,
                             float camera_depth) {
  // Receiver footprint and caster depth are independent at low sun angles.
  // The rectified map stores this angle (beta), not ordinary shadow depth.
  const float half_width=shadow_cascades.shadow_splits.w*(4.0/3.0);
  const float depth_span=max(shadow_cascades.local_depth_spans.w,1.0e-6);
  const float perpendicular=max(projected_radius,0.0)*half_width;
  const float parallel=-(blocker_depth-camera_depth)*depth_span;
  return atan(perpendicular,parallel);
}

uint epipolar_radial_resolution() {
#ifndef FAITHFUL_SHADOW_SPLIT
  return 0U;
#else
  return uint(round(shadow_cascades.epipolar_metadata.x));
#endif
}

uint epipolar_angular_rows() {
#ifndef FAITHFUL_SHADOW_SPLIT
  return 0U;
#else
  return uint(round(shadow_cascades.epipolar_metadata.y));
#endif
}

vec2 linear_lookup_uv(float altitude,float cosine_angle) {
  return vec2(clamp(cosine_angle*0.5+0.5,0.0,1.0),
              clamp(altitude/atmosphere_height(),0.0,1.0));
}

vec2 transmittance_uv(float altitude,float cosine_angle) {
  const float bottom=ground_radius();
  const float top=top_radius();
#ifdef FAITHFUL_SHADOW_SPLIT
  // Interpolate between the stored endpoints so an exact atmosphere-top
  // query reconstructs the exact stored top radius.  Adding the separately
  // rounded bottom and height can land one ULP below top on large planets,
  // turning an outward zero-length ray into a tangent ray in the inverse map.
  const float radius=mix(bottom,top,clamp(
      altitude/max(atmosphere_height(),1.0e-6),0.0,1.0));
#else
  const float radius=bottom+clamp(altitude,0.0,atmosphere_height());
#endif
  cosine_angle=clamp(cosine_angle,-1.0,1.0);
#ifdef FAITHFUL_SHADOW_SPLIT
  // Every outward direction at the exact top boundary has a zero-length
  // atmospheric segment.  State that endpoint explicitly: sqrt(top*top) can
  // round above top and otherwise manufacture a tiny nonzero distance.
  if(altitude>=atmosphere_height()&&cosine_angle>=0.0)
    return vec2(0.0,1.0);
#endif
  const float horizon=atmosphere.reserved3.w;
  const float rho=sqrt(max(0.0,(radius-bottom)*(radius+bottom)));
  const float discriminant=max(0.0,
      radius*radius*(cosine_angle*cosine_angle-1.0)+top*top);
  const float distance=max(0.0,-radius*cosine_angle+sqrt(discriminant));
  const float minimum=top-radius;
  const float maximum=rho+horizon;
  return vec2(clamp((distance-minimum)/max(maximum-minimum,1.0e-6),0.0,1.0),
              clamp(rho/max(horizon,1.0e-6),0.0,1.0));
}

vec2 transmittance_parameters(vec2 uv) {
  uv=clamp(uv,vec2(0.0),vec2(1.0));
  const float bottom=ground_radius();
  const float top=top_radius();
  const float horizon=sqrt(max(0.0,(top-bottom)*(top+bottom)));
  const float rho=horizon*uv.y;
  const float radial_distance=sqrt(rho*rho+bottom*bottom);
  const float altitude=rho*rho/max(radial_distance+bottom,1.0e-6);
  const float radius=bottom+altitude;
  const float minimum=top-radius;
  const float maximum=rho+horizon;
  const float distance=mix(minimum,maximum,uv.x);
  float cosine_angle=1.0;
  if(uv.x>=1.0-1.0e-7)cosine_angle=-rho/radius;
  else if(distance>1.0e-6){
    const float top_minus_radius_squared=(top-radius)*(top+radius);
    cosine_angle=(top_minus_radius_squared-distance*distance)/
        (2.0*radius*distance);
  }
  return vec2(clamp(altitude,0.0,atmosphere_height()),
              clamp(cosine_angle,-1.0,1.0));
}

vec3 bilinear_transmittance_load(vec2 uv) {
  const ivec2 size=imageSize(transmittance_lut);
  const vec2 texel=faithful_transport()?
      clamp(uv,vec2(0.0),vec2(1.0))*vec2(size-1):
      clamp(uv*vec2(size)-0.5,vec2(0.0),vec2(size-1));
  const ivec2 low=ivec2(floor(texel));
  const ivec2 high=min(low+1,size-1);
  const vec2 fraction=fract(texel);
  const vec3 lower=mix(imageLoad(transmittance_lut,low).rgb,
      imageLoad(transmittance_lut,ivec2(high.x,low.y)).rgb,fraction.x);
  const vec3 upper=mix(imageLoad(transmittance_lut,ivec2(low.x,high.y)).rgb,
      imageLoad(transmittance_lut,high).rgb,fraction.x);
  return mix(lower,upper,fraction.y);
}

vec3 lookup_transmittance(vec3 point,vec3 direction) {
  const float altitude=length(point)-ground_radius();
  const float cosine_angle=dot(normalize(point),direction);
  const vec2 uv=faithful_transport()?
      transmittance_uv(altitude,cosine_angle):
      linear_lookup_uv(altitude,cosine_angle);
  return bilinear_transmittance_load(uv)*
      sunlight_visibility(point,direction);
}

vec3 lookup_multiple_scattering(vec3 point,vec3 sun_direction) {
  const float altitude=length(point)-ground_radius();
  const float cosine_angle=dot(normalize(point),sun_direction);
  const ivec2 size=imageSize(multiple_scattering_lut);
  const ivec2 coordinate=clamp(
      ivec2(linear_lookup_uv(altitude,cosine_angle)*vec2(size)),ivec2(0),size-1);
  const vec3 average_radiance=imageLoad(
      multiple_scattering_lut,coordinate).rgb;
  const vec3 density=densities(altitude);
  const vec3 scattering=atmosphere.rayleigh_ground_radius.rgb*density.x+
      atmosphere.mie_scattering_top_radius.rgb*density.y;
  if(faithful_transport())
    return scattering*average_radiance*atmosphere.solar_absorption_peak.rgb;
  return scattering*average_radiance/(1.0-0.35);
}

float bilinear_shadow_visibility(vec2 uv,float layer,float receiver_depth,
                                 float bias) {
  const ivec2 size=textureSize(sun_shadow_map,0).xy;
  const vec2 texel_position=uv*vec2(size)-0.5;
  if(shadow_filter_mode()==0){
    const ivec2 coordinate=clamp(ivec2(round(texel_position)),ivec2(0),size-1);
    const float blocker=texelFetch(
        sun_shadow_map,ivec3(coordinate,int(layer)),0).r;
    return receiver_depth-bias<=blocker?1.0:0.0;
  }
  const ivec2 low=ivec2(floor(texel_position));
  const ivec2 high=low+1;
  const vec2 fraction=fract(texel_position);
  const ivec2 maximum=size-1;
  const float lower_left=receiver_depth-bias<=texelFetch(
      sun_shadow_map,ivec3(clamp(low,ivec2(0),maximum),int(layer)),0).r?1.0:0.0;
  const float lower_right=receiver_depth-bias<=texelFetch(
      sun_shadow_map,ivec3(clamp(ivec2(high.x,low.y),ivec2(0),maximum),
                           int(layer)),0).r?1.0:0.0;
  const float upper_left=receiver_depth-bias<=texelFetch(
      sun_shadow_map,ivec3(clamp(ivec2(low.x,high.y),ivec2(0),maximum),
                           int(layer)),0).r?1.0:0.0;
  const float upper_right=receiver_depth-bias<=texelFetch(
      sun_shadow_map,ivec3(clamp(high,ivec2(0),maximum),int(layer)),0).r?1.0:0.0;
  return mix(mix(lower_left,lower_right,fraction.x),
             mix(upper_left,upper_right,fraction.x),fraction.y);
}


float physical_shadow_visibility(vec2 uv,float layer,float receiver_depth,
                                 float bias,float footprint_texels) {
  if(shadow_filter_mode()!=2)
    return bilinear_shadow_visibility(uv,layer,receiver_depth,bias);
  const vec2 texel=1.0/vec2(textureSize(sun_shadow_map,0).xy);
  const float radius=clamp(footprint_texels,0.5,2.5);
  float visibility=0.0;
  float total=0.0;
  for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
    const float weight=(x==0?2.0:1.0)*(y==0?2.0:1.0);
    visibility+=weight*bilinear_shadow_visibility(
        uv+vec2(x,y)*texel*radius,layer,receiver_depth,bias);
    total+=weight;
  }
  return visibility/total;
}

float moment_hybrid_shadow_visibility(vec2 uv,float layer,
                                      float receiver_depth,float bias,
                                      float footprint_texels) {
  const float fallback=physical_shadow_visibility(
      uv,layer,receiver_depth,bias,footprint_texels);
  if(int(atmosphere.reserved1.w+0.5)!=4)return fallback;
  const ivec2 size=textureSize(sun_shadow_map,0).xy;
  const ivec2 centre=clamp(ivec2(floor(uv*vec2(size))),ivec2(0),size-1);
  vec4 moments=vec4(0.0);
  float support0=-1.0;
  float support1=-1.0;
  int support_count=0;
  for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
    // Form moments at each source sample and only then filter them. Filtering
    // depth first and exponentiating the interpolated result is not a moment
    // shadow map and hides the very depth complexity the confidence gate is
    // meant to detect.
    const float depth=texelFetch(sun_shadow_map,
        ivec3(clamp(centre+ivec2(x,y),ivec2(0),size-1),int(layer)),0).r;
    const float square=depth*depth;
    moments+=vec4(depth,square,square*depth,square*square);
    if(support_count==0){support0=depth;support_count=1;}
    else if(abs(depth-support0)>2.0e-4&&support_count==1){
      support1=depth;support_count=2;
    }else if(abs(depth-support0)>2.0e-4&&
             abs(depth-support1)>2.0e-4) support_count=3;
  }
  moments/=9.0;
  if(support_count>2)return fallback;
  const float threshold=receiver_depth-bias;
  const float variance=moments.y-moments.x*moments.x;
  if(variance<=1.0e-7)return threshold<=moments.x?1.0:0.0;
  const float support_sum=(moments.z-moments.x*moments.y)/variance;
  const float support_product=support_sum*moments.x-moments.y;
  const float discriminant=support_sum*support_sum-4.0*support_product;
  if(discriminant<0.0)return fallback;
  const float root=sqrt(discriminant);
  const float first=0.5*(support_sum-root);
  const float second=0.5*(support_sum+root);
  if(first<-1.0e-4||second>1.0001||second-first<=1.0e-6)return fallback;
  const float predicted_fourth=support_sum*moments.z-
      support_product*moments.y;
  const float residual=abs(predicted_fourth-moments.w);
  // Confidence gating is deliberately strict: a third depth layer, numerical
  // instability, or a broad reconstruction goes through the qualified path.
  if(residual>1.0e-5)return fallback;
  const float first_weight=clamp(
      (second-moments.x)/(second-first),0.0,1.0);
  return (threshold<=first?first_weight:0.0)+
      (threshold<=second?1.0-first_weight:0.0);
}

float atmosphere_fitted_visibility(vec3 point_world) {
  const vec3 projected=(shadow_cascades.shadow_matrices[4]*
      vec4(point_world,1.0)).xyz;
  if(any(greaterThan(abs(projected.xy),vec2(1.0)))||
     projected.z<0.0||projected.z>1.0||
     shadow_cascades.atmosphere_shadow_metadata.x<0.999)return 1.0;
  const float fitted_scale=shadow_cascades.atmosphere_shadow_metadata.w;
  const vec2 uv=(projected.xy*0.5+0.5)*fitted_scale;
  const float bias=shadow_cascades.atmosphere_shadow_metadata.z;
  const float distance_world=length(point_world-atmosphere.reserved0.xyz);
  const float fitted_texel_world=max(
      2.0*shadow_cascades.atmosphere_shadow_metadata.y/
      max(float(textureSize(sun_shadow_map,0).x)*fitted_scale,1.0),1.0e-6);
  const float solar_footprint=tan(atmosphere.profile_and_mode.z)*
      distance_world/fitted_texel_world;
  const float visibility=moment_hybrid_shadow_visibility(
      uv,4.0,projected.z,bias,solar_footprint);
  const float coverage=1.0-smoothstep(
      0.94,0.995,max(abs(projected.x),abs(projected.y)));
  return mix(1.0,visibility,coverage);
}

float atmosphere_cascade_visibility(vec3 point_world,int cascade,
                                    float fallback_visibility) {
  const vec3 projected=(shadow_cascades.shadow_matrices[cascade]*
      vec4(point_world,1.0)).xyz;
  if(any(greaterThan(abs(projected.xy),vec2(1.0)))||
     projected.z<0.0||projected.z>1.0)return fallback_visibility;
  const vec2 uv=projected.xy*0.5+0.5;
  // Keep receiver bias constant in world space across cascades. The split is
  // 0.75 of the orthographic half-width and the depth span is four widths.
  const float depth_span=max(
      shadow_cascades.local_depth_spans[cascade],1.0e-6);
  const float bias=atmosphere_comparison_bias_world()/depth_span;
  const float texel_world=2.0*shadow_cascades.shadow_splits[cascade]*
      (2.0/3.0)/float(textureSize(sun_shadow_map,0).x);
  const float receiver_distance=length(
      point_world-atmosphere.reserved0.xyz);
  const float solar_footprint=tan(atmosphere.profile_and_mode.z)*
      receiver_distance/max(texel_world,1.0e-6);
  const float visibility=moment_hybrid_shadow_visibility(
      uv,float(cascade),projected.z,bias,solar_footprint);
  const float footprint=max(abs(projected.x),abs(projected.y));
  const float footprint_fade=1.0-smoothstep(0.88,0.98,footprint);
  // Preserve unit visibility for an unoccluded sample on both sides of the
  // cascade boundary. Scaling all in-cascade light to 0.25 made the uncovered
  // region four times brighter and produced a yellow halo behind mountains.
  const float filtered_visibility=faithful_transport()?
      visibility:visibility*4.0;
  const float local_visibility=mix(
      fallback_visibility,filtered_visibility,footprint_fade);
  // A low sun can place the caster far outside a receiver's local cascade
  // depth range even though the receiver itself is well inside that cascade.
  // The fitted map carries those long-range casters. It is therefore an
  // additional conservative visibility constraint, not merely an
  // out-of-footprint fallback.
  return min(local_visibility,fallback_visibility);
}

float atmosphere_sun_visibility(vec3 point_metres) {
  // Numeric qualification compares the transport stages with an independent
  // unshadowed CPU integrator. Scene-dependent cascade contents are qualified
  // separately by H7 and would make an exact probe depend on current terrain.
  if(numeric_probe())return 1.0;
  const float metres_per_world=atmosphere.profile_and_mode.y;
  const vec3 point_world=atmosphere.reserved0.xyz+
      (point_metres-atmosphere.camera_position_near.xyz)/metres_per_world;
  const float distance_world=length(point_world-atmosphere.reserved0.xyz);
  const float fitted=atmosphere_fitted_visibility(point_world);
  int cascade=3;
  if(distance_world<shadow_cascades.shadow_splits.x)cascade=0;
  else if(distance_world<shadow_cascades.shadow_splits.y)cascade=1;
  else if(distance_world<shadow_cascades.shadow_splits.z)cascade=2;
  const float current=atmosphere_cascade_visibility(
      point_world,cascade,fitted);
  if(cascade==3){
    // The split distance is a selection threshold, not the physical edge of
    // the outer orthographic map.  While the asynchronous fitted front is
    // unavailable, fading to its unit-visibility fallback at the split
    // discards valid outer-cascade occluders that are still well inside that
    // map.  This was precisely the direct Mie light left on a mountain with
    // the sun behind it.  The footprint fade inside `current` remains the
    // conservative transition at the actual sampled-map boundary.
    if(shadow_cascades.atmosphere_shadow_metadata.x<0.999)return current;
    const float outer_fade=smoothstep(
        shadow_cascades.shadow_splits.w*0.80,
        shadow_cascades.shadow_splits.w,distance_world);
    return mix(current,fitted,outer_fade);
  }
  const float split=shadow_cascades.shadow_splits[cascade];
  const float previous=cascade==0?0.0:
      shadow_cascades.shadow_splits[cascade-1];
  const float blend=smoothstep(mix(previous,split,0.85),split,distance_world);
  return mix(current,atmosphere_cascade_visibility(
      point_world,cascade+1,fitted),blend);
}

float atmosphere_minmax_classify_segment(vec3 origin_metres,
                                         vec3 direction,
                                         float distance_begin,
                                         float distance_end) {
  if(numeric_probe())return -2.0;
  if(shadow_cascades.atmosphere_shadow_metadata.x<0.999)return -2.0;
  const float metres_per_world=atmosphere.profile_and_mode.y;
  const vec3 first_world=atmosphere.reserved0.xyz+
      (origin_metres+direction*distance_begin-
       atmosphere.camera_position_near.xyz)/metres_per_world;
  const vec3 last_world=atmosphere.reserved0.xyz+
      (origin_metres+direction*distance_end-
       atmosphere.camera_position_near.xyz)/metres_per_world;
  // The fitted map is intentionally lower resolution than the local outer
  // cascade. It cannot prove light inside that cascade without risking a
  // missed sub-texel ridge, so the qualified path keeps local point samples
  // authoritative there. The epipolar mode rectifies cascade 3 instead.
  if(length(first_world-atmosphere.reserved0.xyz)<
         shadow_cascades.shadow_splits.w||
     length(last_world-atmosphere.reserved0.xyz)<
         shadow_cascades.shadow_splits.w)return -2.0;
  const vec3 first_projected=(shadow_cascades.shadow_matrices[4]*
      vec4(first_world,1.0)).xyz;
  const vec3 last_projected=(shadow_cascades.shadow_matrices[4]*
      vec4(last_world,1.0)).xyz;
  if(any(greaterThan(max(abs(first_projected.xy),abs(last_projected.xy)),
                     vec2(0.94)))||
     min(first_projected.z,last_projected.z)<0.0||
     max(first_projected.z,last_projected.z)>1.0)return -2.0;
  const uint base_resolution=uint(round(
      float(textureSize(sun_shadow_map,0).x)*
      shadow_cascades.atmosphere_shadow_metadata.w));
  if(base_resolution==0U)return -2.0;
  const vec2 first_texel=(first_projected.xy*0.5+0.5)*
      float(base_resolution)-0.5;
  const vec2 last_texel=(last_projected.xy*0.5+0.5)*
      float(base_resolution)-0.5;
  const float filter_guard=shadow_filter_mode()==2?2.5:
      (shadow_filter_mode()==1?1.0:0.0);
  const vec2 minimum_texel=min(first_texel,last_texel)-filter_guard;
  const vec2 maximum_texel=max(first_texel,last_texel)+filter_guard;
  const float span=max(maximum_texel.x-minimum_texel.x,
                       maximum_texel.y-minimum_texel.y);
  uint level=0U;
  float level_scale=1.0;
  while(level<15U&&span/level_scale>1.0){
    ++level;
    level_scale*=2.0;
  }
  const ivec2 low=ivec2(floor(minimum_texel/level_scale));
  const ivec2 high=ivec2(floor(maximum_texel/level_scale));
  vec2 depth_range=vec2(1.0,0.0);
  for(int y=0;y<2;++y)for(int x=0;x<2;++x){
    const ivec2 coordinate=ivec2(x==0?low.x:high.x,
                                 y==0?low.y:high.y);
    const vec2 range=shadow_minmax_load(level,coordinate,base_resolution);
    depth_range.x=min(depth_range.x,range.x);
    depth_range.y=max(depth_range.y,range.y);
  }
  const float receiver_min=min(first_projected.z,last_projected.z);
  const float receiver_max=max(first_projected.z,last_projected.z);
  const float bias=shadow_cascades.atmosphere_shadow_metadata.z;
  if(receiver_max-bias<=depth_range.x)return 1.0;
  if(receiver_min-bias>depth_range.y)return 0.0;
  return -1.0;
}

float atmosphere_minmax_range_visibility(vec3 origin_metres,
                                         vec3 direction,
                                         float distance_begin,
                                         float distance_end) {
  // Until the rectified epipolar prepass exists, keep one conservative query
  // here. Repeating a full hierarchy walk independently in every atmosphere
  // sample caused multi-minute ridge frames. Ambiguous ranges retain the
  // bounded adaptive fallback below; the prepass will own exact intervals.
  return atmosphere_minmax_classify_segment(
      origin_metres,direction,distance_begin,distance_end);
}

uint epipolar_last_visited_nodes=0U;
uint epipolar_last_emitted_intervals=0U;
uint epipolar_last_fallbacks=0U;
uint epipolar_last_overflows=0U;

uint epipolar_counter_base() {
  return uint(shadow_cascades.epipolar_metadata.w+0.5)-2U;
}

void reset_epipolar_invocation_counters() {
  epipolar_last_visited_nodes=0U;
  epipolar_last_emitted_intervals=0U;
  epipolar_last_fallbacks=0U;
  epipolar_last_overflows=0U;
}

void commit_epipolar_invocation_counters() {
  if(int(atmosphere.reserved1.w+0.5)!=5)return;
  const uint base=epipolar_counter_base();
  atomicAdd(atmosphere_shadow_minmax.ranges[base].x,
            epipolar_last_visited_nodes);
  atomicAdd(atmosphere_shadow_minmax.ranges[base].y,
            epipolar_last_emitted_intervals);
  atomicAdd(atmosphere_shadow_minmax.ranges[base+1U].x,
            epipolar_last_fallbacks);
  atomicAdd(atmosphere_shadow_minmax.ranges[base+1U].y,
            epipolar_last_overflows);
}

float epipolar_fallback() {
  ++epipolar_last_fallbacks;
  return -2.0;
}

float atmosphere_epipolar_range_visibility(vec3 origin_metres,
                                            vec3 direction,
                                            float distance_begin,
                                            float distance_end) {
#ifndef FAITHFUL_SHADOW_SPLIT
  return epipolar_fallback();
#else
  if(numeric_probe())return epipolar_fallback();
  const float metres_per_world=atmosphere.profile_and_mode.y;
  const float first_distance_world=distance_begin/metres_per_world;
  const float last_distance_world=distance_end/metres_per_world;
  // This hierarchy rectifies local cascade 3. Closer samples select or blend
  // higher-resolution cascades, while the final outer band blends to the
  // independently fitted map. A classification from cascade 3 alone is not a
  // proof in either region, so preserve the qualified point fallback there.
  if(first_distance_world<shadow_cascades.shadow_splits.z||
     last_distance_world>shadow_cascades.shadow_splits.w*0.80)
    return epipolar_fallback();
  const vec3 first_world=atmosphere.reserved0.xyz+
      (origin_metres+direction*distance_begin-
       atmosphere.camera_position_near.xyz)/metres_per_world;
  const vec3 last_world=atmosphere.reserved0.xyz+
      (origin_metres+direction*distance_end-
       atmosphere.camera_position_near.xyz)/metres_per_world;
  const vec3 camera_projected=(shadow_cascades.shadow_matrices[3]*
      vec4(atmosphere.reserved0.xyz,1.0)).xyz;
  const vec3 first_projected=(shadow_cascades.shadow_matrices[3]*
      vec4(first_world,1.0)).xyz;
  const vec3 last_projected=(shadow_cascades.shadow_matrices[3]*
      vec4(last_world,1.0)).xyz;
  if(any(greaterThanEqual(abs(camera_projected.xy),vec2(0.94)))||
     any(greaterThan(max(abs(first_projected.xy),abs(last_projected.xy)),
                     vec2(0.94)))||
     min(first_projected.z,last_projected.z)<0.0||
     max(first_projected.z,last_projected.z)>1.0)return epipolar_fallback();
  const vec2 projected_direction=last_projected.xy-first_projected.xy;
  const float projected_length=length(projected_direction);
  // The epipole is singular: a direction parallel to the sun projects to a
  // point rather than a row. Keep the qualified bounded marcher there.
  if(projected_length<1.0e-6)return epipolar_fallback();
  const vec2 row_direction=projected_direction/projected_length;
  const float radius=epipolar_radius_to_guarded_square(
      camera_projected.xy,row_direction);
  if(radius<=1.0e-6)return epipolar_fallback();
  const float q0=dot(first_projected.xy-camera_projected.xy,row_direction)/
      radius;
  const float q1=dot(last_projected.xy-camera_projected.xy,row_direction)/
      radius;
  if(min(q0,q1)<0.0||max(q0,q1)>1.0)return epipolar_fallback();
  const uint radial_resolution=epipolar_radial_resolution();
  const uint angular_rows=epipolar_angular_rows();
  if(radial_resolution==0U||angular_rows==0U)return epipolar_fallback();
  const float angle=atan(row_direction.y,row_direction.x);
  int row=int(floor((angle+PI)/(2.0*PI)*float(angular_rows)));
  row=(row%int(angular_rows)+int(angular_rows))%int(angular_rows);
  const float radial_low=min(q0,q1)*float(radial_resolution);
  const float radial_high=max(q0,q1)*float(radial_resolution);
  const float span=max(radial_high-radial_low,1.0);
  // In true epipolar coordinates beta is constant along an un-biased camera
  // ray.  Apply the physical comparison tolerance by moving the receiver
  // toward the sun before deriving beta; checking both endpoints bounds the
  // small distance-dependent angular change introduced by that move.
  const vec3 sun_direction=normalize(atmosphere.sun_direction_exposure.xyz);
  const vec3 first_biased=direction*max(distance_begin,0.0)+
      sun_direction*atmosphere_comparison_bias_world()*
          atmosphere.profile_and_mode.y;
  const vec3 last_biased=direction*max(distance_end,0.0)+
      sun_direction*atmosphere_comparison_bias_world()*
          atmosphere.profile_and_mode.y;
  const float first_beta=acos(clamp(dot(normalize(first_biased),sun_direction),
                                    -1.0,1.0));
  const float last_beta=acos(clamp(dot(normalize(last_biased),sun_direction),
                                   -1.0,1.0));
  const float receiver_min=min(first_beta,last_beta);
  const float receiver_max=max(first_beta,last_beta);
  const uint query_begin=min(uint(floor(radial_low)),radial_resolution-1U);
  const uint query_end=min(max(uint(ceil(radial_high)),query_begin+1U),
                           radial_resolution);
  uint root_level=0U;
  for(uint width=radial_resolution;width>1U;
      width=max(1U,(width+1U)/2U))++root_level;
  uint stack_levels[16];
  uint stack_indices[16];
  uint stack_count=1U;
  stack_levels[0]=root_level;
  stack_indices[0]=0U;
  int uniform_class=-1;
  uint visited_nodes=0U;
  while(stack_count>0U){
    --stack_count;
    const uint node_level=stack_levels[stack_count];
    const uint node_index=stack_indices[stack_count];
    const uint scale=1U<<node_level;
    const uint node_begin=node_index*scale;
    const uint node_end=min(node_begin+scale,radial_resolution);
    if(node_end<=query_begin||node_begin>=query_end)continue;
    if(++visited_nodes>128U){
      epipolar_last_visited_nodes+=visited_nodes;
      ++epipolar_last_overflows;
      return epipolar_fallback();
    }
    const vec2 node_range=epipolar_minmax_load(
        node_level,int(node_index),row,radial_resolution,angular_rows);
    int node_class=-1;
    if(receiver_max<node_range.x)node_class=1;
    else if(receiver_min>=node_range.y)node_class=0;
    if(node_class>=0){
      ++epipolar_last_emitted_intervals;
      if(uniform_class<0)uniform_class=node_class;
      else if(uniform_class!=node_class){
        epipolar_last_visited_nodes+=visited_nodes;
        const int substeps=clamp(int(ceil(span)),2,32);
        return -float(substeps+2);
      }
      continue;
    }
    if(node_level==0U){
      epipolar_last_visited_nodes+=visited_nodes;
      const int substeps=clamp(int(ceil(span)),2,32);
      return -float(substeps+2);
    }
    if(stack_count+2U>16U){
      epipolar_last_visited_nodes+=visited_nodes;
      ++epipolar_last_overflows;
      return epipolar_fallback();
    }
    const uint child_level=node_level-1U;
    const uint child_width=epipolar_level_width(
        child_level,radial_resolution);
    const uint left=node_index*2U;
    const uint right=left+1U;
    // Push right first so the depth-first traversal visits radial intervals
    // in increasing order when it pops the left child.
    if(right<child_width){
      stack_levels[stack_count]=child_level;
      stack_indices[stack_count++]=right;
    }
    stack_levels[stack_count]=child_level;
    stack_indices[stack_count++]=left;
  }
  epipolar_last_visited_nodes+=visited_nodes;
  if(uniform_class>=0)return float(uniform_class);
  // Ask the integration loop for ordered radial subdivisions. Distance and
  // epipolar radius are affine on a directional camera ray, so these
  // subdivisions align with the rectified row.
  const int substeps=clamp(int(ceil(span)),2,32);
  return -float(substeps+2);
#endif
}

float rayleigh_phase(float cosine_angle) {
  return 3.0*(1.0+cosine_angle*cosine_angle)/(16.0*PI);
}

float mie_phase(float cosine_angle) {
  const float g=atmosphere.ground_albedo_mie_anisotropy.w;
  return (1.0-g*g)/(4.0*PI*pow(
      max(1.0+g*g-2.0*g*cosine_angle,1.0e-4),1.5));
}

vec3 view_direction(vec2 texture_coordinate) {
  const vec2 ndc=texture_coordinate*2.0-1.0;
  return normalize(atmosphere.camera_forward_maximum_distance.xyz+
      atmosphere.camera_right_tangent_x.xyz*ndc.x*
          atmosphere.camera_right_tangent_x.w+
      atmosphere.camera_down_tangent_y.xyz*ndc.y*
          atmosphere.camera_down_tangent_y.w);
}

void full_sky_basis(out vec3 local_up,out vec3 sun_tangent,
                    out vec3 longitude_tangent) {
  local_up=atmosphere.reserved2.xyz;
  sun_tangent=atmosphere.reserved3.xyz;
  longitude_tangent=cross(local_up,sun_tangent);
}

vec3 full_sky_direction(vec2 uv) {
  vec3 local_up,sun_tangent,longitude_tangent;
  full_sky_basis(local_up,sun_tangent,longitude_tangent);
  const float perimeter=(uv.x-0.5)*4.0;
  vec3 tangent;
  if(perimeter>=0.0&&perimeter<=1.0)
    tangent=sun_tangent*(1.0-perimeter)+longitude_tangent*perimeter;
  else if(perimeter>1.0){
    const float offset=perimeter-1.0;
    tangent=sun_tangent*(-offset)+longitude_tangent*(1.0-offset);
  }else if(perimeter>=-1.0)
    tangent=sun_tangent*(1.0+perimeter)+longitude_tangent*perimeter;
  else{
    const float offset=-perimeter-1.0;
    tangent=sun_tangent*(-offset)+longitude_tangent*(-1.0+offset);
  }
  tangent=normalize(tangent);
  if(atmosphere.reserved1.y>=9.5){
    const float bottom=atmosphere.rayleigh_ground_radius.w;
    const float view_height=bottom+max(atmosphere.reserved2.w,0.0);
    const float horizon_cosine=sqrt(max(0.0,
        (view_height-bottom)*(view_height+bottom)))/
        max(view_height,1.0e-6);
    const float beta=acos(clamp(horizon_cosine,0.0,1.0));
    const float zenith_horizon=PI-beta;
    float vertical;
    if(uv.y<0.5){
      float coordinate=1.0-2.0*uv.y;
      coordinate=1.0-coordinate*coordinate;
      vertical=cos(zenith_horizon*coordinate);
    }else{
      float coordinate=2.0*uv.y-1.0;
      coordinate*=coordinate;
      vertical=cos(zenith_horizon+beta*coordinate);
    }
    const float horizontal=sqrt(max(0.0,1.0-vertical*vertical));
    return normalize(tangent*horizontal+local_up*vertical);
  }
  const float mapped_latitude=uv.y*2.0-1.0;
  const float latitude_proxy=mapped_latitude*mapped_latitude;
  const float latitude_shape=0.7853981633974483-1.0;
  const float root=(1.0-latitude_proxy)/
      (1.0+latitude_shape*latitude_proxy);
  const float vertical=sign(mapped_latitude)*(1.0-root*root);
  const float horizontal=sqrt(max(0.0,1.0-vertical*vertical));
  return normalize(tangent*horizontal+local_up*vertical);
}

vec2 full_sky_uv(vec3 direction) {
  vec3 local_up,sun_tangent,longitude_tangent;
  full_sky_basis(local_up,sun_tangent,longitude_tangent);
  const float tangent_x=dot(direction,sun_tangent);
  const float tangent_y=dot(direction,longitude_tangent);
  float perimeter=0.0;
  if(tangent_x>=0.0){
    const float denominator=abs(tangent_x)+abs(tangent_y);
    perimeter=denominator>0.0?tangent_y/denominator:0.0;
  }else if(tangent_y>=0.0){
    const float denominator=-tangent_x+tangent_y;
    perimeter=2.0-tangent_y/denominator;
  }else{
    const float denominator=-tangent_x-tangent_y;
    perimeter=-1.0+tangent_x/denominator;
  }
  const float vertical=clamp(dot(direction,local_up),-1.0,1.0);
  if(atmosphere.reserved1.y>=9.5){
    const float bottom=atmosphere.rayleigh_ground_radius.w;
    const float view_height=bottom+max(atmosphere.reserved2.w,0.0);
    const float horizon_cosine=sqrt(max(0.0,
        (view_height-bottom)*(view_height+bottom)))/
        max(view_height,1.0e-6);
    const float beta=acos(clamp(horizon_cosine,0.0,1.0));
    const float zenith_horizon=PI-beta;
    const float angle=acos(vertical);
    float vertical_uv;
    if(angle<=zenith_horizon){
      float coordinate=1.0-angle/max(zenith_horizon,1.0e-6);
      coordinate=1.0-sqrt(max(coordinate,0.0));
      vertical_uv=coordinate*0.5;
    }else{
      float coordinate=(angle-zenith_horizon)/max(beta,1.0e-6);
      vertical_uv=0.5+0.5*sqrt(max(coordinate,0.0));
    }
    return vec2(perimeter*0.25+0.5,clamp(vertical_uv,0.0,1.0));
  }
  const float latitude_shape=0.7853981633974483-1.0;
  const float root=sqrt(max(0.0,1.0-abs(vertical)));
  const float latitude_proxy=(1.0-root)/(1.0+latitude_shape*root);
  const float mapped_latitude=abs(vertical)<1.0e-6?0.0:
      sign(vertical)*sqrt(latitude_proxy);
  return vec2(perimeter*0.25+0.5,mapped_latitude*0.5+0.5);
}

vec3 sun_focused_sky_direction(vec2 uv) {
  const float focused=uv.x*2.0-1.0;
  const float perimeter=sign(focused)*2.0*focused*focused;
  return full_sky_direction(vec2(perimeter*0.25+0.5,uv.y));
}

vec3 sun_shadow_sky_direction(vec2 uv) {
  const float focused=uv.x-0.5;
  const float magnitude=abs(focused);
  const float perimeter=magnitude<=0.25?magnitude:
      0.25+(magnitude-0.25)*7.0;
  const float full_sky_u=sign(focused)*perimeter*0.25+0.5;
  return full_sky_direction(vec2(full_sky_u,uv.y));
}

vec3 full_sky_load(vec3 direction) {
  const ivec2 size=imageSize(sky_view_lut);
  vec2 uv=full_sky_uv(direction);
  if(atmosphere.reserved1.y>=9.5){
    const vec2 resolution=vec2(size);
    uv=(uv+0.5/resolution)*(resolution/(resolution+1.0));
  }
  const vec2 texel=uv*vec2(size)-0.5;
  const ivec2 low=ivec2(floor(texel));
  const ivec2 high=low+1;
  const int low_x=(low.x%size.x+size.x)%size.x;
  const int high_x=(high.x%size.x+size.x)%size.x;
  const int low_y=clamp(low.y,0,size.y-1);
  const int high_y=clamp(high.y,0,size.y-1);
  const vec2 fraction=fract(texel);
  const vec3 lower=mix(imageLoad(sky_view_lut,ivec2(low_x,low_y)).rgb,
      imageLoad(sky_view_lut,ivec2(high_x,low_y)).rgb,fraction.x);
  const vec3 upper=mix(imageLoad(sky_view_lut,ivec2(low_x,high_y)).rgb,
      imageLoad(sky_view_lut,ivec2(high_x,high_y)).rgb,fraction.x);
  return mix(lower,upper,fraction.y);
}

float atmosphere_minmax_range_visibility(vec3 origin_metres,
    vec3 direction,float distance_begin,float distance_end);

vec3 integrate_scattering(vec3 origin,vec3 direction,float maximum_distance,
                          out vec3 path_transmittance) {
  float begin,end;
  path_transmittance=vec3(1.0);
  if(!medium_segment(origin,direction,begin,end)||maximum_distance<=begin)
    return vec3(0.0);
  end=min(end,maximum_distance);
  // Hillaire's shadowed mode uses 32 content-dependent ray samples. Bias the
  // intervals quadratically toward the camera/atmosphere entry: terrain
  // shadows and the compact planet's dense boundary layer live there, while
  // the upper atmosphere varies slowly and tolerates wider steps.
  const int steps=32;
  const float segment_length=end-begin;
  const vec3 sun_direction=normalize(atmosphere.sun_direction_exposure.xyz);
  const float phase_cosine=dot(direction,sun_direction);
  const float phase_rayleigh=rayleigh_phase(phase_cosine);
  const float phase_mie=mie_phase(phase_cosine);
  vec3 radiance=vec3(0.0);
  vec3 transmittance=vec3(1.0);
  const int shadow_integrator=int(atmosphere.reserved1.w+0.5);
  if(shadow_integrator==0){
  for(int index=0;index<steps;++index){
    const float interval_begin=float(index)/float(steps);
    const float interval_end=float(index+1)/float(steps);
    const float distance_begin=begin+
        segment_length*interval_begin*interval_begin;
    const float distance_end=begin+
        segment_length*interval_end*interval_end;
    const float step_length=distance_end-distance_begin;
    const float distance=0.5*(distance_begin+distance_end);
    const vec3 point=origin+direction*distance;
    const vec3 density=densities(length(point)-ground_radius());
    const vec3 local_extinction=extinction(density);
    const vec3 segment_transmittance=exp(-local_extinction*step_length);
    const vec3 direct_source=(
        atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
        atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
        lookup_transmittance(point,sun_direction)*
        atmosphere.solar_absorption_peak.rgb*
        atmosphere_sun_visibility(point);
    const vec3 multiple_source=lookup_multiple_scattering(point,sun_direction);
    const vec3 source=direct_source+multiple_source;
    const vec3 integral=(vec3(1.0)-segment_transmittance)/
        max(local_extinction,vec3(1.0e-9));
    radiance+=transmittance*source*integral;
    transmittance*=segment_transmittance;
  }
  path_transmittance=transmittance;
  return radiance;
  }
  for(int index=0;index<steps;++index){
    const float interval_begin=float(index)/float(steps);
    const float interval_end=float(index+1)/float(steps);
    const float base_begin=begin+
        segment_length*interval_begin*interval_begin;
    const float base_end=begin+
        segment_length*interval_end*interval_end;
    const float base_middle=0.5*(base_begin+base_end);
    const float visibility_begin=atmosphere_sun_visibility(
        origin+direction*base_begin);
    const float visibility_middle=atmosphere_sun_visibility(
        origin+direction*base_middle);
    const float visibility_end=atmosphere_sun_visibility(
        origin+direction*base_end);
    const float visibility_range=max(visibility_begin,
        max(visibility_middle,visibility_end))-min(visibility_begin,
        min(visibility_middle,visibility_end));
    const float minmax_visibility=shadow_integrator==5?
        atmosphere_epipolar_range_visibility(origin,direction,base_begin,
                                              base_end):
        ((shadow_integrator==2||shadow_integrator==4)?
        atmosphere_minmax_range_visibility(origin,direction,base_begin,
                                            base_end):-2.0);
    const int hierarchy_substeps=minmax_visibility<=-3.0?
        clamp(int(round(-minmax_visibility))-2,2,32):1;
    int substeps=hierarchy_substeps>1?hierarchy_substeps:
        (visibility_range>0.02?8:1);
    if(shadow_integrator==3)substeps=32;
    for(int substep=0;substep<32;++substep){
      if(substep>=substeps)break;
      const float sub_begin=mix(base_begin,base_end,
          float(substep)/float(substeps));
      const float sub_end=mix(base_begin,base_end,
          float(substep+1)/float(substeps));
      const float step_length=sub_end-sub_begin;
      const float distance=0.5*(sub_begin+sub_end);
      const vec3 point=origin+direction*distance;
      const vec3 density=densities(length(point)-ground_radius());
      const vec3 local_extinction=extinction(density);
      const vec3 segment_transmittance=exp(-local_extinction*step_length);
      float resolved_visibility=substeps==1&&minmax_visibility>=0.0?
          minmax_visibility:-1.0;
      // A -2 result explicitly delegates this interval to the qualified
      // point sampler. Re-query only when the hierarchy requested ordered
      // subdivisions; otherwise every substep would repeat the same known
      // out-of-domain fallback.
      if(shadow_integrator==5&&minmax_visibility<=-3.0)
        resolved_visibility=atmosphere_epipolar_range_visibility(
            origin,direction,sub_begin,sub_end);
      const float direct_visibility=resolved_visibility>=0.0?
          resolved_visibility:atmosphere_sun_visibility(point);
      const vec3 direct_source=(
          atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
          atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
          lookup_transmittance(point,sun_direction)*
          atmosphere.solar_absorption_peak.rgb*
          direct_visibility;
      const vec3 multiple_source=lookup_multiple_scattering(point,sun_direction);
      const vec3 integral=(vec3(1.0)-segment_transmittance)/
          max(local_extinction,vec3(1.0e-9));
      radiance+=transmittance*(direct_source+multiple_source)*integral;
      transmittance*=segment_transmittance;
    }
  }
  path_transmittance=transmittance;
  return radiance;
}

