void generate_transmittance(ivec2 coordinate) {
  const ivec2 size=imageSize(transmittance_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=faithful_transport()?
      vec2(coordinate)/vec2(max(size-1,ivec2(1))):
      (vec2(coordinate)+0.5)/vec2(size);
  const vec2 parameters=faithful_transport()?
      transmittance_parameters(uv):
      vec2(mix(1.0,atmosphere_height()-1.0,uv.y),uv.x*2.0-1.0);
  const float altitude=parameters.x;
  const float cosine_angle=parameters.y;
  const vec3 origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 direction=normalize(vec3(sqrt(max(0.0,1.0-
      cosine_angle*cosine_angle)),cosine_angle,0.0));
  float begin,end;
  vec3 value=vec3(1.0);
  const bool has_segment=faithful_transport()?
      outer_medium_segment(origin,direction,begin,end):
      medium_segment(origin,direction,begin,end);
  if(has_segment)
    value=integrate_transmittance(origin+direction*begin,direction,end-begin,
        faithful_transport()?128:32,faithful_transport());
  imageStore(transmittance_lut,coordinate,checked_lut_value(value,1.0));
}

void generate_multiple_scattering(ivec2 coordinate) {
  const ivec2 size=imageSize(multiple_scattering_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  const float altitude=mix(1.0,atmosphere_height()-1.0,uv.y);
  const float sun_cosine=uv.x*2.0-1.0;
  const vec3 origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 sun_direction=normalize(vec3(
      sqrt(max(0.0,1.0-sun_cosine*sun_cosine)),sun_cosine,0.0));
  vec3 incoming=vec3(0.0);
  vec3 transfer=vec3(0.0);
  const int direction_count=faithful_transport()?64:8;
  for(int direction_index=0;direction_index<64;++direction_index){
    if(direction_index>=direction_count)break;
    const float y=1.0-2.0*(float(direction_index)+0.5)/
        float(direction_count);
    const float angle=float(direction_index)*2.39996323;
    const vec3 direction=vec3(sqrt(max(0.0,1.0-y*y))*cos(angle),y,
                              sqrt(max(0.0,1.0-y*y))*sin(angle));
    float begin,end;
    if(!medium_segment(origin,direction,begin,end))continue;
    const int steps=faithful_transport()?20:6;
    const float step_length=(end-begin)/float(steps);
    vec3 view_transmittance=vec3(1.0);
    for(int step=0;step<steps;++step){
      const vec3 point=origin+direction*(begin+(float(step)+0.5)*step_length);
      const vec3 density=densities(length(point)-ground_radius());
      const vec3 local_extinction=extinction(density);
      const vec3 segment_transmittance=exp(-local_extinction*step_length);
      const vec3 scattering=atmosphere.rayleigh_ground_radius.rgb*density.x+
          atmosphere.mie_scattering_top_radius.rgb*density.y;
      const vec3 unit_illuminance=faithful_transport()?vec3(1.0):
          atmosphere.solar_absorption_peak.rgb;
      const vec3 source=scattering*lookup_transmittance(point,sun_direction)*
          unit_illuminance/(4.0*PI);
      const vec3 integral=(vec3(1.0)-segment_transmittance)/
          max(local_extinction,vec3(1.0e-9));
      incoming+=view_transmittance*source*integral;
      if(faithful_transport())
        transfer+=view_transmittance*scattering*integral;
      view_transmittance*=segment_transmittance;
    }
    if(faithful_transport()){
      const vec3 endpoint=origin+direction*end;
      if(length(endpoint)<=ground_radius()+5.0){
        const vec3 normal=normalize(endpoint);
        const float n_dot_l=max(dot(normal,sun_direction),0.0);
        const vec3 reflected=atmosphere.ground_albedo_mie_anisotropy.rgb*
            lookup_transmittance(endpoint+normal,sun_direction)*n_dot_l/PI;
        incoming+=view_transmittance*reflected;
      }
    }
  }
  incoming/=float(direction_count);
  transfer/=float(direction_count);
  if(faithful_transport()){
    // Hillaire 2020, equations 7-10: integrate the unitless local transfer
    // f_ms independently from second-order light, then close all remaining
    // isotropic orders as a bounded geometric series.
    const vec3 f_ms=clamp(transfer,vec3(0.0),vec3(0.999));
    incoming*=vec3(1.0)/max(vec3(1.0)-f_ms,vec3(1.0e-3));
  }
  // Preserve average incident radiance directly. Storing the much smaller
  // scattering*incoming source in RGBA16F loses dusk illumination precision;
  // lookup_multiple_scattering reconstructs that source where it is needed.
  imageStore(multiple_scattering_lut,coordinate,
             checked_lut_value(incoming,65504.0));
}

void generate_sky_view(ivec2 coordinate) {
  const ivec2 size=imageSize(sky_view_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  const vec3 direction=faithful_transport()?full_sky_direction(uv):
      view_direction(uv);
  vec3 transmittance;
#ifdef FAITHFUL_SHADOW_SPLIT
  vec3 radiance;
  if(faithful_transport())
    radiance=integrate_scattering_unshadowed(
        atmosphere.camera_position_near.xyz,direction,1.0e9,transmittance);
  else
    radiance=integrate_scattering(atmosphere.camera_position_near.xyz,
        direction,1.0e9,transmittance);
#else
  vec3 radiance=integrate_scattering(atmosphere.camera_position_near.xyz,
      direction,1.0e9,transmittance);
#endif
  imageStore(sky_view_lut,coordinate,checked_lut_value(radiance,65504.0));
}

void generate_aerial(ivec3 coordinate) {
  const ivec3 size=imageSize(aerial_scattering_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate.xy)+0.5)/vec2(size.xy);
  const float slice=float(coordinate.z)/float(max(size.z-1,1));
  const float distance=slice*slice*slice*
      atmosphere.camera_forward_maximum_distance.w;
  const vec3 direction=faithful_transport()?
      sun_focused_sky_direction(uv):view_direction(uv);
  vec3 transmittance;
#ifdef FAITHFUL_SHADOW_SPLIT
  // Terrain visibility is carried by the dedicated long-shadow field and
  // composed at the final ray. Keeping the aerial volume unshadowed avoids
  // duplicating the same expensive visibility integration in two caches.
  const vec3 radiance=integrate_scattering_unshadowed(
      atmosphere.camera_position_near.xyz,direction,distance,transmittance);
#else
  const vec3 radiance=integrate_scattering(
      atmosphere.camera_position_near.xyz,direction,distance,
      transmittance);
#endif
  imageStore(aerial_scattering_lut,coordinate,
             checked_lut_value(radiance,65504.0));
  imageStore(aerial_transmittance_lut,coordinate,
             checked_lut_value(transmittance,1.0));
}

// Deterministic screen candidates must differ from the native oracle only in
// where the result is evaluated and reconstructed.  In particular, retain the
// oracle's radial-altitude interval placement: distance-space intervals change
// the number of samples inside the compact Mie layer as the camera moves.
// Direct sunlight is visibility-weighted at the quadrature point; multiple
// scattering stays positive and unshadowed.
void reconstructed_interval(vec3 origin,vec3 direction,float begin,float end,
                            float closest,float ground,float closest_radius,
                            float closest_altitude,float altitude_power,
                            int index,out float distance_begin,
                            out float distance_end) {
  const float segment_epsilon=max((end-begin)*1.0e-6,1.0e-3);
  const bool has_before=closest>begin+segment_epsilon;
  const bool has_after=end>closest+segment_epsilon;
  const bool split=has_before&&has_after;
  const bool before=split?index<16:has_before;
  const int interval_count=split?16:32;
  const int local_index=split?(before?index:index-16):index;
  const float u0=float(local_index)/float(interval_count);
  const float u1=float(local_index+1)/float(interval_count);
  const float side_distance=before?begin:end;
  const float side_altitude=max(
      length(origin+direction*side_distance)-ground,closest_altitude);
  const float altitude_begin=mix(closest_altitude,side_altitude,
      pow(before?1.0-u0:u0,altitude_power));
  const float altitude_end=mix(closest_altitude,side_altitude,
      pow(before?1.0-u1:u1,altitude_power));
  const float offset_begin=sqrt(max(
      (ground+altitude_begin)*(ground+altitude_begin)-
      closest_radius*closest_radius,0.0));
  const float offset_end=sqrt(max(
      (ground+altitude_end)*(ground+altitude_end)-
      closest_radius*closest_radius,0.0));
  distance_begin=closest+(before?-offset_begin:offset_begin);
  distance_end=closest+(before?-offset_end:offset_end);
}

bool previous_history_coordinate(vec2 uv,vec4 endpoint,
                                 out ivec2 coordinate,
                                 out float expected_depth);

vec3 integrate_reconstructed_screen(vec3 origin,vec3 direction,
                                    float maximum_distance,
                                    out vec3 path_transmittance,
                                    out float transition_confidence,
                                    int shadow_query_count,
                                    uint temporal_phase,
                                    ivec2 visibility_history_coordinate,
                                    ivec2 ray_visibility_coordinate) {
  float begin,end;
  path_transmittance=vec3(1.0);
  transition_confidence=1.0;
  if(!medium_segment(origin,direction,begin,end)||maximum_distance<=begin)
    return vec3(0.0);
  end=min(end,maximum_distance);
  const float closest=clamp(-dot(origin,direction),begin,end);
  const vec3 sun_direction=normalize(atmosphere.sun_direction_exposure.xyz);
  const float phase_cosine=dot(direction,sun_direction);
  const float phase_rayleigh=rayleigh_phase(phase_cosine);
  const float phase_mie=mie_phase(phase_cosine);
  const float ground=ground_radius();
  const float closest_radius=length(origin+direction*closest);
  const float closest_altitude=max(closest_radius-ground,0.0);
  const float mie_scale=max(atmosphere.absorption_mie_scale.w,1.0);
  const float altitude_power=mix(2.0,5.0,
      exp(-closest_altitude/(4.0*mie_scale)));
  const uint previous_visibility_index=(temporal_phase>>5U)&1U;
  const uint output_visibility_index=(temporal_phase>>6U)&1U;
  const bool visibility_history_valid=(temporal_phase&128U)!=0U;
  const bool temporal_visibility=(temporal_phase&256U)!=0U;
  uvec2 packed_visibility=uvec2(0U);
  if(shadow_query_count<32&&visibility_history_valid)
    packed_visibility=previous_visibility_index==0U?
        imageLoad(history_visibility_0,visibility_history_coordinate).xy:
        imageLoad(history_visibility_1,visibility_history_coordinate).xy;
  const int query_count=shadow_query_count>=32?32:
      (shadow_query_count>=8?8:(shadow_query_count<=1?1:2));
  const int phase=int(temporal_phase&uint(32/query_count-1));
  for(int sample_index=0;sample_index<32;++sample_index){
    if(sample_index>=query_count)break;
    const int interval=query_count==32?sample_index:
        sample_index*(32/query_count)+phase;
      float sample_begin,sample_end;
      reconstructed_interval(origin,direction,begin,end,closest,ground,
          closest_radius,closest_altitude,altitude_power,interval,
          sample_begin,sample_end);
      const vec3 sample_point=origin+direction*
          (0.5*(sample_begin+sample_end));
    float visibility=atmosphere_sun_visibility(sample_point);
#ifdef TETRA_METAL_RAY_TRACED_VISIBILITY
    if(atmosphere.temporal_control.w>0.5)
      visibility=float(imageLoad(terrain_ray_visibility,
          ivec3(ray_visibility_coordinate,interval)).r)/255.0;
#endif
    const uint quantized=uint(round(clamp(visibility,0.0,1.0)*3.0));
    const uint channel=uint(interval)/16U;
    const uint shift=(uint(interval)&15U)*2U;
    packed_visibility[channel]=(packed_visibility[channel]&~(3U<<shift))|
        (quantized<<shift);
  }
  if(temporal_visibility){
    if(output_visibility_index==0U)
      imageStore(history_visibility_0,ivec2(gl_GlobalInvocationID.xy),
                 uvec4(packed_visibility,0U,0U));
    else imageStore(history_visibility_1,ivec2(gl_GlobalInvocationID.xy),
                    uvec4(packed_visibility,0U,0U));
  }
  vec3 radiance=vec3(0.0);
  vec3 transmittance=vec3(1.0);
  for(int index=0;index<32;++index){
    float distance_begin,distance_end;
    reconstructed_interval(origin,direction,begin,end,closest,ground,
        closest_radius,closest_altitude,altitude_power,index,
        distance_begin,distance_end);
    const float step_length=distance_end-distance_begin;
    if(step_length<=0.0)continue;
    const vec3 point=origin+direction*
        (0.5*(distance_begin+distance_end));
    const vec3 density=densities(length(point)-ground);
    const vec3 local_extinction=extinction(density);
    const vec3 segment_transmittance=exp(-local_extinction*step_length);
    const uint channel=uint(index)/16U;
    const uint shift=(uint(index)&15U)*2U;
    const float centre_visibility=float(
        (packed_visibility[channel]>>shift)&3U)/3.0;
    const int previous_index=max(index-1,0);
    const int next_index=min(index+1,31);
    const uint previous_channel=uint(previous_index)/16U;
    const uint previous_shift=(uint(previous_index)&15U)*2U;
    const uint next_channel=uint(next_index)/16U;
    const uint next_shift=(uint(next_index)&15U)*2U;
    const float previous_visibility=float(
        (packed_visibility[previous_channel]>>previous_shift)&3U)/3.0;
    const float next_visibility=float(
        (packed_visibility[next_channel]>>next_shift)&3U)/3.0;
    // Reconstruct a continuous interval-average visibility from neighbouring
    // radial samples. Using each midpoint as a piecewise-constant value
    // stamped displaced copies of a mountain silhouette into the haze. This
    // compact tent is exact on constant visibility runs and only smooths the
    // two intervals adjacent to an actual shadow transition.
    const float terrain_visibility=(previous_visibility+
        2.0*centre_visibility+next_visibility)*0.25;
    transition_confidence=min(transition_confidence,
        abs(centre_visibility-0.5)*2.0);
    const vec3 direct_source=(
        atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
        atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
        lookup_transmittance(point,sun_direction)*
        atmosphere.solar_absorption_peak.rgb*terrain_visibility;
    const vec3 multiple_source=lookup_multiple_scattering(point,sun_direction);
    const vec3 integral=(vec3(1.0)-segment_transmittance)/
        max(local_extinction,vec3(1.0e-9));
    radiance+=transmittance*(direct_source+multiple_source)*integral;
    transmittance*=segment_transmittance;
  }
  path_transmittance=transmittance;
  return radiance;
}

float pack_reconstructed_endpoint_offset(bool opaque,ivec2 offset) {
  return opaque?1.0+float(offset.y*4+offset.x):0.0;
}

bool reconstructed_endpoint_is_opaque(vec4 endpoint) {
  return endpoint.y>0.5;
}

ivec2 unpack_reconstructed_endpoint_offset(vec4 endpoint) {
  const uint packed=uint(round(endpoint.y));
  const uint offset=packed>0U?packed-1U:0U;
  return ivec2(int(offset&3U),int(offset>>2U));
}

void generate_reconstructed_endpoint(ivec2 coordinate) {
  const ivec2 output_size=active_screen_size();
  if(any(greaterThanEqual(coordinate,output_size)))return;
  const ivec2 depth_size=active_scene_size();
  const int divisor=clamp(int(dispatch_mode.reserved1),1,4);
  const ivec2 base=coordinate*divisor;
  float nearest_depth=0.0;
  int opaque_count=0;
  float farthest_opaque_depth=1.0;
  ivec2 representative=min(base,depth_size-1);
  for(int y=0;y<4;++y)for(int x=0;x<4;++x){
    if(x>=divisor||y>=divisor)continue;
    const ivec2 source=min(base+ivec2(x,y),depth_size-1);
    const float depth=texelFetch(scene_depth,source,0).r;
    if(depth>nearest_depth){
      nearest_depth=depth;
      representative=source;
    }
    if(depth>1.0e-8){
      ++opaque_count;
      farthest_opaque_depth=min(farthest_opaque_depth,depth);
    }
  }
  const bool opaque=nearest_depth>1.0e-8;
  const float linear_depth=opaque?
      atmosphere.camera_position_near.w/nearest_depth:0.0;
  const float depth_spread=opaque_count>1?
      1.0-farthest_opaque_depth/max(nearest_depth,1.0e-8):0.0;
  const float class_confidence=(opaque_count==0||
      opaque_count==divisor*divisor)?1.0:0.0;
  const float transition_confidence=class_confidence*
      (1.0-clamp(depth_spread/0.05,0.0,1.0));
  imageStore(screen_endpoint,coordinate,
      vec4(linear_depth,pack_reconstructed_endpoint_offset(opaque,
               representative-base),transition_confidence,
           uintBitsToFloat(dispatch_mode.reserved0)));
}

void generate_reconstructed_scattering(ivec2 coordinate) {
  const ivec2 output_size=active_screen_size();
  if(any(greaterThanEqual(coordinate,output_size)))return;
  const ivec2 depth_size=active_scene_size();
  // The desktop ray-traced backend is native resolution. Clamping its
  // divisor to two addresses the atmosphere texture as though it were half
  // resolution, displacing terrain-shaped visibility across the sky.
  const int divisor=clamp(int(dispatch_mode.reserved0),1,4);
  const ivec2 base=coordinate*divisor;
  const vec4 endpoint=imageLoad(screen_endpoint,coordinate);
  const bool opaque=reconstructed_endpoint_is_opaque(endpoint);
  const ivec2 representative=min(base+unpack_reconstructed_endpoint_offset(
      endpoint),depth_size-1);
  // P4a's test-only control preserves the old scan for paired measurements.
  // Production always uses the endpoint-selected native coordinate above.
  ivec2 legacy_representative=representative;
  if(opaque&&(dispatch_mode.reserved2&1024U)!=0U){
    float nearest_depth=0.0;
    for(int y=0;y<4;++y)for(int x=0;x<4;++x){
      if(x>=divisor||y>=divisor)continue;
      const ivec2 source=min(base+ivec2(x,y),depth_size-1);
      const float depth=texelFetch(scene_depth,source,0).r;
      if(depth>nearest_depth){nearest_depth=depth;legacy_representative=source;}
    }
  }
  const vec2 uv=opaque?
      (vec2(legacy_representative)+0.5)/vec2(depth_size):
      (vec2(base)+vec2(float(divisor)*0.5))/vec2(depth_size);
  ivec2 visibility_history_coordinate=coordinate;
  uint visibility_control=dispatch_mode.reserved2;
  if((visibility_control&128U)!=0U&&(visibility_control&512U)!=0U){
    float expected_depth;
    if(!previous_history_coordinate(uv,endpoint,
         visibility_history_coordinate,expected_depth))
      visibility_control&=~128U;
  }
  vec3 transmittance;
  float shadow_confidence;
  const vec3 radiance=integrate_reconstructed_screen(
      atmosphere.camera_position_near.xyz,view_direction(uv),
      opaque?endpoint.x:1.0e9,transmittance,shadow_confidence,
      clamp(int(dispatch_mode.reserved1),2,32),visibility_control,
      visibility_history_coordinate,coordinate);
  imageStore(screen_scattering,coordinate,
      checked_lut_value(radiance,65504.0));
  imageStore(screen_transmittance,coordinate,
      checked_lut_value(transmittance,1.0));
  imageStore(screen_endpoint,coordinate,vec4(
      endpoint.xy,min(endpoint.z,shadow_confidence),endpoint.w));
}

void generate_shadowed_froxel(ivec3 coordinate) {
  const ivec3 size=imageSize(froxel_scattering);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate.xy)+0.5)/vec2(size.xy);
  const float slice=(float(coordinate.z)+0.5)/float(size.z);
  const float distance=slice*slice*slice*
      atmosphere.camera_forward_maximum_distance.w;
  vec3 transmittance;
  float transition_confidence;
  const vec3 radiance=integrate_reconstructed_screen(
      atmosphere.camera_position_near.xyz,view_direction(uv),distance,
      transmittance,transition_confidence,32,0U,coordinate.xy,coordinate.xy);
  imageStore(froxel_scattering,coordinate,
      checked_lut_value(radiance,65504.0));
  imageStore(froxel_transmittance,coordinate,
      checked_lut_value(transmittance,1.0));
}

vec4 history_scattering_load(uint index,ivec2 coordinate) {
  return index==0U?imageLoad(history_scattering_0,coordinate):
      imageLoad(history_scattering_1,coordinate);
}

vec4 history_transmittance_load(uint index,ivec2 coordinate) {
  return index==0U?imageLoad(history_transmittance_0,coordinate):
      imageLoad(history_transmittance_1,coordinate);
}

vec4 history_endpoint_load(uint index,ivec2 coordinate) {
  return index==0U?imageLoad(history_endpoint_0,coordinate):
      imageLoad(history_endpoint_1,coordinate);
}

void history_store(uint index,ivec2 coordinate,vec4 scattering,
                   vec4 transmittance,vec4 endpoint) {
  if(index==0U){
    imageStore(history_scattering_0,coordinate,scattering);
    imageStore(history_transmittance_0,coordinate,transmittance);
    imageStore(history_endpoint_0,coordinate,endpoint);
  }else{
    imageStore(history_scattering_1,coordinate,scattering);
    imageStore(history_transmittance_1,coordinate,transmittance);
    imageStore(history_endpoint_1,coordinate,endpoint);
  }
}

bool previous_history_coordinate(vec2 uv,vec4 endpoint,
                                 out ivec2 coordinate,
                                 out float expected_depth) {
  const vec3 direction=view_direction(uv);
  vec3 previous_vector=direction;
  if(endpoint.y>0.5){
    const vec3 point=atmosphere.camera_position_near.xyz+
        direction*endpoint.x;
    previous_vector=point-atmosphere.previous_camera_position_near.xyz;
    expected_depth=length(previous_vector);
  }else expected_depth=0.0;
  const float forward=dot(previous_vector,
      atmosphere.previous_camera_forward.xyz);
  if(forward<=1.0e-6)return false;
  const vec2 ndc=vec2(
      dot(previous_vector,atmosphere.previous_camera_right_tangent_x.xyz)/
          (forward*atmosphere.previous_camera_right_tangent_x.w),
      dot(previous_vector,atmosphere.previous_camera_down_tangent_y.xyz)/
          (forward*atmosphere.previous_camera_down_tangent_y.w));
  const vec2 previous_uv=ndc*0.5+0.5;
  if(any(lessThan(previous_uv,vec2(0.0)))||
     any(greaterThanEqual(previous_uv,vec2(1.0))))return false;
  const ivec2 size=active_screen_size();
  coordinate=clamp(ivec2(previous_uv*vec2(size)),ivec2(0),size-1);
  return true;
}

void resolve_reconstructed_history(ivec2 coordinate) {
  const ivec2 size=active_screen_size();
  if(any(greaterThanEqual(coordinate,size)))return;
  const uint previous_index=dispatch_mode.reserved0;
  const uint output_index=dispatch_mode.reserved1;
  const vec4 current_endpoint=imageLoad(screen_endpoint,coordinate);
  vec4 resolved_scattering=imageLoad(screen_scattering,coordinate);
  vec4 resolved_transmittance=imageLoad(screen_transmittance,coordinate);
  bool accept=atmosphere.temporal_control.x>0.5&&
      current_endpoint.z>0.5;
  ivec2 previous_coordinate=coordinate;
  float expected_depth=0.0;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  accept=accept&&previous_history_coordinate(
      uv,current_endpoint,previous_coordinate,expected_depth);
  vec4 previous_endpoint=vec4(0.0);
  if(accept){
    previous_endpoint=history_endpoint_load(
        previous_index,previous_coordinate);
    accept=floatBitsToUint(previous_endpoint.w)==
        floatBitsToUint(atmosphere.temporal_control.y)&&
        (previous_endpoint.y>0.5)==(current_endpoint.y>0.5)&&
        previous_endpoint.z>0.5;
  }
  if(accept&&current_endpoint.y>0.5){
    const float threshold=max(expected_depth*0.05,1.0e-5);
    accept=abs(previous_endpoint.x-expected_depth)<threshold;
  }
  if(accept){
    vec3 minimum_scattering=vec3(65504.0);
    vec3 maximum_scattering=vec3(0.0);
    vec3 minimum_transmittance=vec3(1.0);
    vec3 maximum_transmittance=vec3(0.0);
    for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
      const ivec2 neighbour=clamp(coordinate+ivec2(x,y),ivec2(0),size-1);
      const vec4 neighbour_endpoint=imageLoad(screen_endpoint,neighbour);
      if((neighbour_endpoint.y>0.5)!=(current_endpoint.y>0.5))continue;
      const vec3 scattering=imageLoad(screen_scattering,neighbour).rgb;
      const vec3 transmittance=imageLoad(screen_transmittance,neighbour).rgb;
      minimum_scattering=min(minimum_scattering,scattering);
      maximum_scattering=max(maximum_scattering,scattering);
      minimum_transmittance=min(minimum_transmittance,transmittance);
      maximum_transmittance=max(maximum_transmittance,transmittance);
    }
    const vec3 previous_scattering=clamp(history_scattering_load(
        previous_index,previous_coordinate).rgb,
        minimum_scattering,maximum_scattering);
    const vec3 previous_transmittance=clamp(history_transmittance_load(
        previous_index,previous_coordinate).rgb,
        minimum_transmittance,maximum_transmittance);
    const float blend=clamp(atmosphere.temporal_control.z,0.0,0.95);
    resolved_scattering.rgb=mix(resolved_scattering.rgb,
                                  previous_scattering,blend);
    resolved_transmittance.rgb=mix(resolved_transmittance.rgb,
                                    previous_transmittance,blend);
  }
  history_store(output_index,coordinate,resolved_scattering,
                resolved_transmittance,current_endpoint);
}

void publish_reconstructed_history(ivec2 coordinate) {
  const ivec2 size=active_screen_size();
  if(any(greaterThanEqual(coordinate,size)))return;
  const uint index=dispatch_mode.reserved0;
  imageStore(screen_scattering,coordinate,
      history_scattering_load(index,coordinate));
  imageStore(screen_transmittance,coordinate,
      history_transmittance_load(index,coordinate));
  imageStore(screen_endpoint,coordinate,
      history_endpoint_load(index,coordinate));
}

#ifdef FAITHFUL_SHADOW_SPLIT
void generate_long_shadow(ivec2 coordinate) {
  const ivec2 size=imageSize(long_shadow_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  // Refresh one coherent 8x8 workgroup class per frame. Sixteen phases keep
  // the expensive terrain-visibility integration below a 120 Hz frame budget
  // without reducing the lookup's spatial resolution.
  const uint update_phase=dispatch_mode.reserved0;
  const uint texel_phase=(uint(coordinate.x/8)&3U)|
      ((uint(coordinate.y/8)&3U)<<2U);
  if(update_phase!=0xffffffffU&&texel_phase!=update_phase)return;
  reset_epipolar_invocation_counters();
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  // Store loss by planet/sun-relative direction rather than framebuffer
  // direction. Camera rotation can then reuse exactly the same texels instead
  // of regenerating and resampling a coarse screen-aligned field.
  const vec3 direction=sun_shadow_sky_direction(uv);
  // Cascaded terrain visibility is exactly one beyond the outer split.  March
  // only the interval where a terrain shadow can exist; distributing the same
  // 32 samples over the complete atmosphere skipped metre-to-kilometre ridge
  // shadows on long horizon rays.
  const float shadow_reach_metres=
      shadow_cascades.atmosphere_shadow_metadata.y*
      atmosphere.profile_and_mode.y;
  const int debug_view=int(atmosphere.reserved1.x+0.5);
  if(debug_view==23||debug_view==24){
    float begin,end;
    float classification=-2.0;
    if(medium_segment(atmosphere.camera_position_near.xyz,direction,begin,end)){
      if(debug_view==24){
        begin=max(begin,shadow_cascades.shadow_splits.z*
            atmosphere.profile_and_mode.y);
        end=min(end,shadow_cascades.shadow_splits.w*0.80*
            atmosphere.profile_and_mode.y);
      }
      if(end>begin)
      classification=atmosphere_epipolar_range_visibility(
          atmosphere.camera_position_near.xyz,direction,begin,
          min(end,shadow_reach_metres));
    }
    const vec3 diagnostic=debug_view==24?
        vec3(min(float(epipolar_last_visited_nodes)/128.0,1.0),
             min(float(epipolar_last_emitted_intervals)/64.0,1.0),
             epipolar_last_overflows>0U?1.0:
                 (classification>-2.5&&classification<-1.5?0.5:0.0)):
        (classification>=0.5?vec3(0.0,1.0,0.0):
         (classification>=0.0?vec3(1.0,0.0,0.0):
          (classification<=-3.0?vec3(0.0,0.0,1.0):
           vec3(1.0,1.0,0.0))));
    imageStore(long_shadow_lut,coordinate,vec4(diagnostic,1.0));
    commit_epipolar_invocation_counters();
    return;
  }
  float maximum_shadow_loss;
  vec3 unshadowed_direct;
  const vec3 shadowed_direct=integrate_shadowed_direct_radiance(
      atmosphere.camera_position_near.xyz,direction,
      shadow_reach_metres,
      maximum_shadow_loss,unshadowed_direct);
  // Store bounded spectral visibility, not a radiance value to subtract later.
  // This keeps approximation error from becoming negative light or a black
  // halo when the exact and cached paths blend.
  const vec3 visibility=clamp(
      shadowed_direct/max(unshadowed_direct,vec3(1.0e-9)),
      vec3(0.0),vec3(1.0));
  const vec4 checked=checked_lut_value(visibility,1.0);
  imageStore(long_shadow_lut,coordinate,
      vec4(checked.rgb,checked.a*maximum_shadow_loss));
  commit_epipolar_invocation_counters();
}
#endif

void reset_epipolar_counters() {
  if(any(notEqual(gl_GlobalInvocationID,uvec3(0))))return;
  const uint base=epipolar_counter_base();
  atmosphere_shadow_minmax.ranges[base]=uvec2(0U);
  atmosphere_shadow_minmax.ranges[base+1U]=uvec2(0U);
}

void generate_shadow_minmax(ivec2 coordinate) {
  const uint level=dispatch_mode.reserved0;
  const uint base_resolution=dispatch_mode.reserved1;
  const uint size=shadow_minmax_level_size(level,base_resolution);
  if(any(greaterThanEqual(coordinate,ivec2(size))))return;
  vec2 range;
  if(level==0U){
    const int source_layer=int(dispatch_mode.reserved2);
    if(source_layer==4){
      const float depth=texelFetch(sun_shadow_map,
          ivec3(coordinate,source_layer),0).r;
      range=vec2(depth);
    }else{
      // Conservatively reduce the higher-resolution outer local cascade into
      // the reusable hierarchy allocation. Both dimensions use the same
      // integer quality-profile ratio (currently two).
      const uint source_size=uint(textureSize(sun_shadow_map,0).x);
      const uint scale=max(1U,(source_size+base_resolution-1U)/
          base_resolution);
      const ivec2 first=coordinate*int(scale);
      range=vec2(1.0,0.0);
      for(uint y=0U;y<4U;++y)for(uint x=0U;x<4U;++x){
        if(x>=scale||y>=scale)continue;
        const ivec2 source=min(first+ivec2(x,y),
            ivec2(int(source_size)-1));
        const float depth=texelFetch(sun_shadow_map,
            ivec3(source,source_layer),0).r;
        range.x=min(range.x,depth);
        range.y=max(range.y,depth);
      }
    }
  }else{
    range=vec2(1.0,0.0);
    const ivec2 first=coordinate*2;
    const uint previous_size=shadow_minmax_level_size(
        level-1U,base_resolution);
    for(int y=0;y<2;++y)for(int x=0;x<2;++x){
      const ivec2 child=first+ivec2(x,y);
      if(any(greaterThanEqual(child,ivec2(previous_size))))continue;
      const vec2 child_range=shadow_minmax_load(
          level-1U,child,base_resolution);
      range.x=min(range.x,child_range.x);
      range.y=max(range.y,child_range.y);
    }
  }
  atmosphere_shadow_minmax.ranges[
      shadow_minmax_level_offset(level,base_resolution)+
      uint(coordinate.y)*size+uint(coordinate.x)]=floatBitsToUint(range);
}

vec2 conservative_shadow_range(vec2 minimum_projected,
                               vec2 maximum_projected,
                               uint base_resolution) {
  const vec2 minimum_texel=(minimum_projected*0.5+0.5)*
      float(base_resolution)-0.5;
  const vec2 maximum_texel=(maximum_projected*0.5+0.5)*
      float(base_resolution)-0.5;
  const float span=max(maximum_texel.x-minimum_texel.x,
                       maximum_texel.y-minimum_texel.y);
  uint level=0U;
  float scale=1.0;
  while(level<15U&&span/scale>1.0){
    ++level;
    scale*=2.0;
  }
  const ivec2 low=ivec2(floor(minimum_texel/scale));
  const ivec2 high=ivec2(floor(maximum_texel/scale));
  vec2 range=vec2(1.0,0.0);
  for(int y=0;y<2;++y)for(int x=0;x<2;++x){
    const ivec2 cell=ivec2(x==0?low.x:high.x,y==0?low.y:high.y);
    const vec2 sample_range=shadow_minmax_load(level,cell,base_resolution);
    range.x=min(range.x,sample_range.x);
    range.y=max(range.y,sample_range.y);
  }
  return range;
}

#ifdef FAITHFUL_SHADOW_SPLIT
void generate_epipolar_shadow_base(ivec2 coordinate) {
  const uint radial_resolution=dispatch_mode.reserved1;
  const uint angular_rows=dispatch_mode.reserved2;
  if(any(greaterThanEqual(coordinate,
      ivec2(int(radial_resolution),int(angular_rows)))))return;
  vec2 range=vec2(0.0,PI);
  const vec3 camera_projected=(shadow_cascades.shadow_matrices[3]*
      vec4(atmosphere.reserved0.xyz,1.0)).xyz;
  if(all(lessThan(abs(camera_projected.xy),vec2(0.94)))){
    const float centre_angle=(float(coordinate.y)+0.5)*2.0*PI/
        float(angular_rows)-PI;
    const float half_angle=PI/float(angular_rows);
    const float q0=float(coordinate.x)/float(radial_resolution);
    const float q1=float(coordinate.x+1)/float(radial_resolution);
    vec2 minimum_projected=vec2(1.0e20);
    vec2 maximum_projected=vec2(-1.0e20);
    for(int angular_corner=0;angular_corner<2;++angular_corner){
      const float angle=centre_angle+
          (angular_corner==0?-half_angle:half_angle);
      const vec2 direction=vec2(cos(angle),sin(angle));
      const float radius=epipolar_radius_to_guarded_square(
          camera_projected.xy,direction);
      const vec2 first=camera_projected.xy+direction*(q0*radius);
      const vec2 last=camera_projected.xy+direction*(q1*radius);
      minimum_projected=min(minimum_projected,min(first,last));
      maximum_projected=max(maximum_projected,max(first,last));
    }
    const uint shadow_base_resolution=uint(textureSize(sun_shadow_map,0).x);
    const float guard_texels=shadow_filter_mode()==2?2.5:
        (shadow_filter_mode()==1?1.0:0.0);
    const vec2 projected_guard=vec2(
        2.0*guard_texels/max(float(shadow_base_resolution),1.0));
    minimum_projected-=projected_guard;
    maximum_projected+=projected_guard;
    const vec2 minimum_texel=(minimum_projected*0.5+0.5)*
        float(shadow_base_resolution)-0.5;
    const vec2 maximum_texel=(maximum_projected*0.5+0.5)*
        float(shadow_base_resolution)-0.5;
    const ivec2 low=ivec2(floor(minimum_texel));
    const ivec2 high=ivec2(ceil(maximum_texel));
    const ivec2 extent=high-low+1;
    // Balanced rows normally cover only a few source texels. An oblique bin
    // that exceeds the bounded footprint is marked ambiguous so traversal
    // falls back instead of silently missing a blocker.
    if(all(lessThanEqual(extent,ivec2(16)))){
      range=vec2(PI,0.0);
      for(int y=0;y<16;++y)for(int x=0;x<16;++x){
        if(x>=extent.x||y>=extent.y)continue;
        const ivec2 source=clamp(low+ivec2(x,y),ivec2(0),
            ivec2(int(shadow_base_resolution)-1));
        const float depth=texelFetch(
            sun_shadow_map,ivec3(source,3),0).r;
        const vec2 projected=(vec2(source)+0.5)/
            float(shadow_base_resolution)*2.0-1.0;
        const float beta=depth>=1.0-1.0e-7?PI:
            epipolar_blocker_angle(
                length(projected-camera_projected.xy),depth,
                camera_projected.z);
        range.x=min(range.x,beta);
        range.y=max(range.y,beta);
      }
    }
  }
  atmosphere_shadow_minmax.ranges[
      uint(coordinate.y)*radial_resolution+uint(coordinate.x)]=
          floatBitsToUint(range);
}

void generate_epipolar_shadow_mip(ivec2 coordinate) {
  const uint level=dispatch_mode.reserved0;
  const uint radial_resolution=dispatch_mode.reserved1;
  const uint angular_rows=dispatch_mode.reserved2;
  const uint width=epipolar_level_width(level,radial_resolution);
  if(coordinate.x>=int(width)||coordinate.y>=int(angular_rows))return;
  vec2 range;
  if(level==0U)return;
  const int first=coordinate.x*2;
  range=epipolar_minmax_load(level-1U,first,coordinate.y,
                             radial_resolution,angular_rows);
  const uint previous_width=epipolar_level_width(
      level-1U,radial_resolution);
  if(uint(first+1)<previous_width){
    const vec2 second=epipolar_minmax_load(
        level-1U,first+1,coordinate.y,radial_resolution,angular_rows);
    range=vec2(min(range.x,second.x),max(range.y,second.y));
  }
  atmosphere_shadow_minmax.ranges[
      epipolar_level_offset(level,radial_resolution,angular_rows)+
      uint(coordinate.y)*width+uint(coordinate.x)]=floatBitsToUint(range);
}
#endif

void generate_sky_irradiance(ivec2 coordinate) {
  const ivec2 size=imageSize(sky_irradiance_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=vec2(coordinate)/vec2(max(size-1,ivec2(1)));
  const vec3 normal=full_sky_direction(uv);
  const vec3 local_up=normalize(atmosphere.camera_position_near.xyz);
  vec3 irradiance_over_pi=vec3(0.0);
  const int direction_count=64;
  for(int index=0;index<direction_count;++index){
    const float y=1.0-2.0*(float(index)+0.5)/float(direction_count);
    const float angle=float(index)*2.39996323;
    const float radial=sqrt(max(0.0,1.0-y*y));
    const vec3 direction=vec3(radial*cos(angle),y,radial*sin(angle));
    const float cosine_weight=max(dot(normal,direction),0.0);
    const float sky_visibility=dot(local_up,direction)>0.0?1.0:0.0;
    irradiance_over_pi+=full_sky_load(direction)*cosine_weight*sky_visibility;
  }
  irradiance_over_pi*=4.0/float(direction_count);
  imageStore(sky_irradiance_lut,coordinate,
             checked_lut_value(irradiance_over_pi,65504.0));
}

vec3 irradiance_load(vec3 normal) {
  const vec2 uv=full_sky_uv(normal);
  const ivec2 size=imageSize(sky_irradiance_lut);
  // The compact directional table includes both poles and the duplicated
  // longitude seam as endpoints. Bilinear reconstruction then evaluates the
  // requested normal instead of substituting a distant texel centre.
  const vec2 texel=clamp(uv,vec2(0.0),vec2(1.0))*vec2(size-1);
  const ivec2 low=ivec2(floor(texel));
  const ivec2 high=min(low+1,size-1);
  const vec2 fraction=fract(texel);
  const vec3 lower=mix(imageLoad(sky_irradiance_lut,low).rgb,
      imageLoad(sky_irradiance_lut,ivec2(high.x,low.y)).rgb,fraction.x);
  const vec3 upper=mix(imageLoad(sky_irradiance_lut,
      ivec2(low.x,high.y)).rgb,imageLoad(sky_irradiance_lut,high).rgb,
      fraction.x);
  return mix(lower,upper,fraction.y);
}

void generate_boundary_probe(int case_index,float altitude,
                             float cosine_angle) {
  const int base=10+case_index*3;
  const vec2 uv=transmittance_uv(altitude,cosine_angle);
  atmosphere_probe.values[base]=vec4(
      uv,transmittance_parameters(uv));
  atmosphere_probe.values[base+1]=vec4(
      bilinear_transmittance_load(uv),1.0);
  const vec3 origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 direction=normalize(vec3(sqrt(max(0.0,1.0-
      cosine_angle*cosine_angle)),cosine_angle,0.0));
  float begin,end;
  vec3 exact=vec3(1.0);
  if(medium_segment(origin,direction,begin,end))
    exact=integrate_transmittance(origin+direction*begin,direction,end-begin,
        faithful_transport()?128:32,faithful_transport());
  atmosphere_probe.values[base+2]=vec4(exact,1.0);
}

void generate_numeric_probe() {
  if(any(notEqual(gl_GlobalInvocationID,uvec3(0))))return;
  const float altitude=clamp(atmosphere_height()*0.05,1.0,
                             atmosphere_height()-1.0);
  const float cosine_angle=0.25;
  const vec3 lookup_origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 lookup_direction=normalize(vec3(
      sqrt(max(0.0,1.0-cosine_angle*cosine_angle)),cosine_angle,0.0));
  const vec2 lookup_uv=transmittance_uv(altitude,cosine_angle);
  vec3 exact_transmittance=vec3(1.0);
  float begin,end;
  if(medium_segment(lookup_origin,lookup_direction,begin,end))
    exact_transmittance=integrate_transmittance(
        lookup_origin+lookup_direction*begin,lookup_direction,end-begin,
        faithful_transport()?128:32,faithful_transport());
  atmosphere_probe.values[0]=vec4(
      bilinear_transmittance_load(lookup_uv),1.0);
  atmosphere_probe.values[1]=vec4(exact_transmittance,1.0);
  const ivec2 multiple_size=imageSize(multiple_scattering_lut);
  const ivec2 multiple_coordinate=clamp(ivec2(
      linear_lookup_uv(altitude,cosine_angle)*vec2(multiple_size)),
      ivec2(0),multiple_size-1);
  atmosphere_probe.values[2]=imageLoad(
      multiple_scattering_lut,multiple_coordinate);
  const vec3 camera_direction=normalize(
      atmosphere.camera_forward_maximum_distance.xyz);
  atmosphere_probe.values[3]=vec4(full_sky_load(camera_direction),1.0);
  atmosphere_probe.values[4]=vec4(irradiance_load(
      normalize(atmosphere.camera_position_near.xyz)),1.0);
  const ivec3 aerial_size=imageSize(aerial_scattering_lut);
  const float probe_distance=atmosphere.camera_forward_maximum_distance.w*0.5;
  const float slice=pow(0.5,1.0/3.0);
  const ivec3 aerial_coordinate=clamp(ivec3(
      ivec2(aerial_size.xy/2),int(round(slice*float(aerial_size.z-1)))),
      ivec3(0),aerial_size-1);
  atmosphere_probe.values[5]=imageLoad(
      aerial_scattering_lut,aerial_coordinate);
  atmosphere_probe.values[6]=imageLoad(
      aerial_transmittance_lut,aerial_coordinate);
  vec3 exact_aerial_transmittance;
#ifdef FAITHFUL_SHADOW_SPLIT
  const vec3 exact_aerial=integrate_scattering_unshadowed(
#else
  const vec3 exact_aerial=integrate_scattering(
#endif
      atmosphere.camera_position_near.xyz,camera_direction,probe_distance,
      exact_aerial_transmittance);
  atmosphere_probe.values[7]=vec4(exact_aerial,1.0);
  atmosphere_probe.values[8]=vec4(exact_aerial_transmittance,1.0);
  const vec2 inverse_parameters=transmittance_parameters(lookup_uv);
  atmosphere_probe.values[9]=vec4(lookup_uv,inverse_parameters);
  const float one_metre_altitude=min(1.0,atmosphere_height());
  const float one_metre_radius=ground_radius()+one_metre_altitude;
  const float horizon_cosine=-sqrt(max(0.0,
      one_metre_altitude*(one_metre_radius+ground_radius())/
          (one_metre_radius*one_metre_radius)));
  generate_boundary_probe(0,0.0,1.0);
  generate_boundary_probe(1,0.0,0.0);
  generate_boundary_probe(2,one_metre_altitude,horizon_cosine);
  generate_boundary_probe(3,atmosphere_height()*0.5,0.0);
  generate_boundary_probe(4,atmosphere_height()*0.5,1.0);
  generate_boundary_probe(5,atmosphere_height(),-1.0);
  generate_boundary_probe(6,atmosphere_height(),1.0);
}

void generate_shadow_projection_probe() {
  if(any(notEqual(gl_GlobalInvocationID,uvec3(0))))return;
  // The host seeds values[0..23] with CPU-generated world points and a
  // cascade index in w. Transforming those exact points here qualifies the
  // std140 matrix upload and GLSL convention, rather than testing a shader
  // against points reconstructed by the same shader.
  for(int index=0;index<24;++index){
    const vec4 request=atmosphere_probe.values[index];
    const int cascade=clamp(int(round(request.w)),0,3);
    const vec3 projected=(shadow_cascades.shadow_matrices[cascade]*
        vec4(request.xyz,1.0)).xyz;
    const bool sampleable=all(lessThanEqual(abs(projected.xy),vec2(1.0)))&&
        projected.z>=0.0&&projected.z<=1.0;
    atmosphere_probe.values[index]=vec4(
        projected,sampleable?1.0:0.0);
  }
}

void main() {
#ifdef TETRA_ATMOSPHERE_SPECIALIZED_MODE
#if TETRA_ATMOSPHERE_SPECIALIZED_MODE==0
  generate_transmittance(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==1
  generate_multiple_scattering(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==2
  generate_sky_view(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==3
  generate_aerial(ivec3(gl_GlobalInvocationID));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==4
  generate_sky_irradiance(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==5
  generate_numeric_probe();
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==6
  generate_long_shadow(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==7
  generate_shadow_projection_probe();
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==8
  generate_shadow_minmax(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==9
  generate_epipolar_shadow_base(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==10
  generate_epipolar_shadow_mip(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==11
  reset_epipolar_counters();
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==12
  generate_reconstructed_endpoint(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==13
  generate_reconstructed_scattering(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==14
  resolve_reconstructed_history(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==15
  publish_reconstructed_history(ivec2(gl_GlobalInvocationID.xy));
#elif TETRA_ATMOSPHERE_SPECIALIZED_MODE==16
  generate_shadowed_froxel(ivec3(gl_GlobalInvocationID));
#else
#error Unsupported TETRA_ATMOSPHERE_SPECIALIZED_MODE
#endif
#else
  if(dispatch_mode.mode==0U)generate_transmittance(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==1U)
    generate_multiple_scattering(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==2U)generate_sky_view(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==3U)generate_aerial(ivec3(gl_GlobalInvocationID));
  else if(dispatch_mode.mode==4U)
    generate_sky_irradiance(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==5U)generate_numeric_probe();
#ifdef FAITHFUL_SHADOW_SPLIT
  else if(dispatch_mode.mode==6U)
    generate_long_shadow(ivec2(gl_GlobalInvocationID.xy));
#endif
  else if(dispatch_mode.mode==7U)generate_shadow_projection_probe();
  else if(dispatch_mode.mode==8U)
    generate_shadow_minmax(ivec2(gl_GlobalInvocationID.xy));
  #ifdef FAITHFUL_SHADOW_SPLIT
  else if(dispatch_mode.mode==9U)
    generate_epipolar_shadow_base(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==10U)
    generate_epipolar_shadow_mip(ivec2(gl_GlobalInvocationID.xy));
  #endif
  else if(dispatch_mode.mode==11U)reset_epipolar_counters();
  else if(dispatch_mode.mode==12U)
    generate_reconstructed_endpoint(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==13U)
    generate_reconstructed_scattering(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==14U)
    resolve_reconstructed_history(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==15U)
    publish_reconstructed_history(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==16U)
    generate_shadowed_froxel(ivec3(gl_GlobalInvocationID));
#endif
}
