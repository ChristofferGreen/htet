#version 450

layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(rgba16f,set=0,binding=0) uniform image2D transmittance_lut;
layout(rgba16f,set=0,binding=1) uniform image2D multiple_scattering_lut;
layout(rgba16f,set=0,binding=2) uniform image2D sky_view_lut;
layout(rgba16f,set=0,binding=3) uniform image3D aerial_scattering_lut;
layout(rgba16f,set=0,binding=4) uniform image3D aerial_transmittance_lut;
layout(set=0,binding=6) uniform sampler2DArray sun_shadow_map;

layout(std140,set=0,binding=5) uniform Atmosphere {
  vec4 rayleigh_ground_radius;
  vec4 mie_scattering_top_radius;
  vec4 mie_absorption_rayleigh_scale;
  vec4 absorption_mie_scale;
  vec4 ground_albedo_mie_anisotropy;
  vec4 solar_absorption_peak;
  vec4 profile_and_mode;
  vec4 camera_position_near;
  vec4 camera_right_tangent_x;
  vec4 camera_down_tangent_y;
  vec4 camera_forward_maximum_distance;
  vec4 sun_direction_exposure;
  vec4 reserved0;
  vec4 reserved1;
  vec4 reserved2;
  vec4 reserved3;
} atmosphere;

layout(std140,set=0,binding=7) uniform ShadowCascades {
  mat4 shadow_matrices[4];
  vec4 shadow_splits;
} shadow_cascades;

layout(push_constant) uniform DispatchMode {
  uint mode;
  uint reserved0;
  uint reserved1;
  uint reserved2;
} dispatch_mode;

const float PI=3.14159265358979323846;

float ground_radius(){return atmosphere.rayleigh_ground_radius.w;}
float top_radius(){return atmosphere.mie_scattering_top_radius.w;}
float atmosphere_height(){return top_radius()-ground_radius();}

vec2 sphere_roots(vec3 origin,vec3 direction,float radius) {
  const float b=dot(origin,direction);
  // Avoid subtracting two planet-radius-squared values to recover a few
  // metres of altitude. That cancellation quantizes the tangent decision in
  // float and appears as horizontal sky bands near the horizon.
  const float radial_distance=length(origin);
  const float c=(radial_distance-radius)*(radial_distance+radius);
  const float discriminant=b*b-c;
  if(discriminant<0.0)return vec2(1.0,-1.0);
  const float root=sqrt(max(discriminant,0.0));
  return vec2(-b-root,-b+root);
}

bool medium_segment(vec3 origin,vec3 direction,out float begin,out float end) {
  const vec2 outer=sphere_roots(origin,direction,top_radius());
  if(outer.y<0.0)return false;
  begin=max(0.0,outer.x);
  end=outer.y;
  const vec2 ground=sphere_roots(origin,direction,ground_radius());
  if(ground.y>=0.0){
    if(length(origin)<ground_radius())begin=max(begin,ground.y);
    else if(ground.x>begin+0.01)end=min(end,ground.x);
  }
  return end>begin;
}

float sunlight_visibility(vec3 point,vec3 direction) {
  const float radial_distance=length(point);
  if(radial_distance<=ground_radius())return 0.0;
  const float cosine_angle=dot(point/radial_distance,direction);
  const float altitude=radial_distance-ground_radius();
  const float horizon_sine_squared=max(0.0,
      altitude*(radial_distance+ground_radius())/
          (radial_distance*radial_distance));
  const float horizon_cosine=-sqrt(horizon_sine_squared);
  const float angular_width=max(atmosphere.profile_and_mode.z,1.0e-5);
  const float cosine_width=max(sin(angular_width),1.0e-5);
  return smoothstep(horizon_cosine-cosine_width,
                    horizon_cosine+cosine_width,cosine_angle);
}

vec3 densities(float altitude) {
  if(altitude<0.0||altitude>atmosphere_height())return vec3(0.0);
  const float rayleigh=exp(-altitude/atmosphere.mie_absorption_rayleigh_scale.w);
  const float mie=exp(-altitude/atmosphere.absorption_mie_scale.w);
  const float absorption=max(0.0,1.0-
      abs(altitude-atmosphere.solar_absorption_peak.w)/
          atmosphere.profile_and_mode.x);
  return vec3(rayleigh,mie,absorption);
}

vec3 extinction(vec3 density) {
  return atmosphere.rayleigh_ground_radius.rgb*density.x+
      (atmosphere.mie_scattering_top_radius.rgb+
       atmosphere.mie_absorption_rayleigh_scale.rgb)*density.y+
      atmosphere.absorption_mie_scale.rgb*density.z;
}

vec3 integrate_transmittance(vec3 origin,vec3 direction,float distance,
                             int steps) {
  if(distance<=0.0)return vec3(1.0);
  const float step_length=distance/float(steps);
  vec3 optical_depth=vec3(0.0);
  for(int index=0;index<32;++index){
    if(index>=steps)break;
    const vec3 point=origin+direction*((float(index)+0.5)*step_length);
    optical_depth+=extinction(densities(length(point)-ground_radius()))*
        step_length;
  }
  return exp(-max(optical_depth,vec3(0.0)));
}

vec4 checked_lut_value(vec3 value,float maximum_value) {
  const bool finite=!(any(isnan(value))||any(isinf(value)));
  const bool in_range=finite&&all(greaterThanEqual(value,vec3(0.0)))&&
      all(lessThanEqual(value,vec3(maximum_value)));
  return vec4(in_range?value:clamp(finite?value:vec3(0.0),
                                  vec3(0.0),vec3(maximum_value)),
              in_range?1.0:0.0);
}

bool faithful_transport(){return atmosphere.reserved1.y>0.5;}

vec2 linear_lookup_uv(float altitude,float cosine_angle) {
  return vec2(clamp(cosine_angle*0.5+0.5,0.0,1.0),
              clamp(altitude/atmosphere_height(),0.0,1.0));
}

vec2 transmittance_uv(float altitude,float cosine_angle) {
  const float bottom=ground_radius();
  const float top=top_radius();
  const float radius=bottom+clamp(altitude,0.0,atmosphere_height());
  cosine_angle=clamp(cosine_angle,-1.0,1.0);
  const float horizon=sqrt(max(0.0,(top-bottom)*(top+bottom)));
  const float rho=sqrt(max(0.0,(radius-bottom)*(radius+bottom)));
  const float discriminant=max(0.0,
      radius*radius*(cosine_angle*cosine_angle-1.0)+top*top);
  const float distance=max(0.0,-radius*cosine_angle+sqrt(discriminant));
  const float minimum=top-radius;
  const float maximum=rho+horizon;
  return vec2(clamp((distance-minimum)/max(maximum-minimum,1.0e-6),0.0,1.0),
              clamp(rho/max(horizon,1.0e-6),0.0,1.0));
}

vec2 transmittance_parameters(vec2 uv) {
  uv=clamp(uv,vec2(0.0),vec2(1.0));
  const float bottom=ground_radius();
  const float top=top_radius();
  const float horizon=sqrt(max(0.0,(top-bottom)*(top+bottom)));
  const float rho=horizon*uv.y;
  const float radius=sqrt(rho*rho+bottom*bottom);
  const float minimum=top-radius;
  const float maximum=rho+horizon;
  const float distance=mix(minimum,maximum,uv.x);
  float cosine_angle=1.0;
  if(distance>1.0e-6){
    const float top_minus_radius_squared=(top-radius)*(top+radius);
    cosine_angle=(top_minus_radius_squared-distance*distance)/
        (2.0*radius*distance);
  }
  return vec2(clamp(radius-bottom,0.0,atmosphere_height()),
              clamp(cosine_angle,-1.0,1.0));
}

vec3 bilinear_transmittance_load(vec2 uv) {
  const ivec2 size=imageSize(transmittance_lut);
  const vec2 texel=clamp(uv*vec2(size)-0.5,vec2(0.0),vec2(size-1));
  const ivec2 low=ivec2(floor(texel));
  const ivec2 high=min(low+1,size-1);
  const vec2 fraction=fract(texel);
  const vec3 lower=mix(imageLoad(transmittance_lut,low).rgb,
      imageLoad(transmittance_lut,ivec2(high.x,low.y)).rgb,fraction.x);
  const vec3 upper=mix(imageLoad(transmittance_lut,ivec2(low.x,high.y)).rgb,
      imageLoad(transmittance_lut,high).rgb,fraction.x);
  return mix(lower,upper,fraction.y);
}

vec3 lookup_transmittance(vec3 point,vec3 direction) {
  const float altitude=length(point)-ground_radius();
  const float cosine_angle=dot(normalize(point),direction);
  const vec2 uv=faithful_transport()?
      transmittance_uv(altitude,cosine_angle):
      linear_lookup_uv(altitude,cosine_angle);
  return bilinear_transmittance_load(uv)*
      sunlight_visibility(point,direction);
}

vec3 lookup_multiple_scattering(vec3 point,vec3 sun_direction) {
  const float altitude=length(point)-ground_radius();
  const float cosine_angle=dot(normalize(point),sun_direction);
  const ivec2 size=imageSize(multiple_scattering_lut);
  const ivec2 coordinate=clamp(
      ivec2(linear_lookup_uv(altitude,cosine_angle)*vec2(size)),ivec2(0),size-1);
  const vec3 average_radiance=imageLoad(
      multiple_scattering_lut,coordinate).rgb;
  const vec3 density=densities(altitude);
  const vec3 scattering=atmosphere.rayleigh_ground_radius.rgb*density.x+
      atmosphere.mie_scattering_top_radius.rgb*density.y;
  if(faithful_transport())
    return scattering*average_radiance*atmosphere.solar_absorption_peak.rgb;
  return scattering*average_radiance/(1.0-0.35);
}

float atmosphere_cascade_visibility(vec3 point_world,int cascade) {
  const vec3 projected=(shadow_cascades.shadow_matrices[cascade]*
      vec4(point_world,1.0)).xyz;
  if(any(greaterThan(abs(projected.xy),vec2(1.0)))||
     projected.z<0.0||projected.z>1.0)return 1.0;
  const vec2 uv=projected.xy*0.5+0.5;
  const vec2 texel=1.0/vec2(textureSize(sun_shadow_map,0).xy);
  const float bias=0.00045*(1.0+float(cascade)*0.45);
  float visibility=0.0;
  for(int y=0;y<2;++y)for(int x=0;x<2;++x){
    const vec2 offset=(vec2(x,y)-0.5)*texel;
    const float blocker=texture(sun_shadow_map,
        vec3(uv+offset,float(cascade))).r;
    visibility+=projected.z-bias<=blocker?1.0:0.0;
  }
  const float footprint=max(abs(projected.x),abs(projected.y));
  const float footprint_fade=1.0-smoothstep(0.88,0.98,footprint);
  // Preserve unit visibility for an unoccluded sample on both sides of the
  // cascade boundary. Scaling all in-cascade light to 0.25 made the uncovered
  // region four times brighter and produced a yellow halo behind mountains.
  return mix(1.0,visibility,footprint_fade);
}

float atmosphere_sun_visibility(vec3 point_metres) {
  const float metres_per_world=atmosphere.profile_and_mode.y;
  const vec3 point_world=atmosphere.reserved0.xyz+
      (point_metres-atmosphere.camera_position_near.xyz)/metres_per_world;
  const float distance_world=length(point_world-atmosphere.reserved0.xyz);
  int cascade=3;
  if(distance_world<shadow_cascades.shadow_splits.x)cascade=0;
  else if(distance_world<shadow_cascades.shadow_splits.y)cascade=1;
  else if(distance_world<shadow_cascades.shadow_splits.z)cascade=2;
  const float current=atmosphere_cascade_visibility(point_world,cascade);
  if(cascade==3){
    const float outer_fade=smoothstep(
        shadow_cascades.shadow_splits.w*0.80,
        shadow_cascades.shadow_splits.w,distance_world);
    return mix(current,1.0,outer_fade);
  }
  const float split=shadow_cascades.shadow_splits[cascade];
  const float previous=cascade==0?0.0:
      shadow_cascades.shadow_splits[cascade-1];
  const float blend=smoothstep(mix(previous,split,0.85),split,distance_world);
  return mix(current,atmosphere_cascade_visibility(point_world,cascade+1),blend);
}

float rayleigh_phase(float cosine_angle) {
  return 3.0*(1.0+cosine_angle*cosine_angle)/(16.0*PI);
}

float mie_phase(float cosine_angle) {
  const float g=atmosphere.ground_albedo_mie_anisotropy.w;
  return (1.0-g*g)/(4.0*PI*pow(
      max(1.0+g*g-2.0*g*cosine_angle,1.0e-4),1.5));
}

vec3 view_direction(vec2 texture_coordinate) {
  const vec2 ndc=texture_coordinate*2.0-1.0;
  return normalize(atmosphere.camera_forward_maximum_distance.xyz+
      atmosphere.camera_right_tangent_x.xyz*ndc.x*
          atmosphere.camera_right_tangent_x.w+
      atmosphere.camera_down_tangent_y.xyz*ndc.y*
          atmosphere.camera_down_tangent_y.w);
}

vec3 integrate_scattering(vec3 origin,vec3 direction,float maximum_distance,
                          out vec3 path_transmittance) {
  float begin,end;
  path_transmittance=vec3(1.0);
  if(!medium_segment(origin,direction,begin,end)||maximum_distance<=begin)
    return vec3(0.0);
  end=min(end,maximum_distance);
  // Hillaire's shadowed mode uses 32 content-dependent ray samples. Bias the
  // intervals quadratically toward the camera/atmosphere entry: terrain
  // shadows and the compact planet's dense boundary layer live there, while
  // the upper atmosphere varies slowly and tolerates wider steps.
  const int steps=32;
  const float segment_length=end-begin;
  const vec3 sun_direction=normalize(atmosphere.sun_direction_exposure.xyz);
  const float phase_cosine=dot(direction,sun_direction);
  const float phase_rayleigh=rayleigh_phase(phase_cosine);
  const float phase_mie=mie_phase(phase_cosine);
  vec3 radiance=vec3(0.0);
  vec3 transmittance=vec3(1.0);
  for(int index=0;index<steps;++index){
    const float interval_begin=float(index)/float(steps);
    const float interval_end=float(index+1)/float(steps);
    const float distance_begin=begin+
        segment_length*interval_begin*interval_begin;
    const float distance_end=begin+
        segment_length*interval_end*interval_end;
    const float step_length=distance_end-distance_begin;
    const float distance=0.5*(distance_begin+distance_end);
    const vec3 point=origin+direction*distance;
    const vec3 density=densities(length(point)-ground_radius());
    const vec3 local_extinction=extinction(density);
    const vec3 segment_transmittance=exp(-local_extinction*step_length);
    const vec3 direct_source=(
        atmosphere.rayleigh_ground_radius.rgb*density.x*phase_rayleigh+
        atmosphere.mie_scattering_top_radius.rgb*density.y*phase_mie)*
        lookup_transmittance(point,sun_direction)*
        atmosphere.solar_absorption_peak.rgb*
        atmosphere_sun_visibility(point);
    const vec3 multiple_source=lookup_multiple_scattering(point,sun_direction);
    const vec3 source=direct_source+multiple_source;
    const vec3 integral=(vec3(1.0)-segment_transmittance)/
        max(local_extinction,vec3(1.0e-9));
    radiance+=transmittance*source*integral;
    transmittance*=segment_transmittance;
  }
  path_transmittance=transmittance;
  return radiance;
}

void generate_transmittance(ivec2 coordinate) {
  const ivec2 size=imageSize(transmittance_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  const vec2 parameters=faithful_transport()?
      transmittance_parameters(uv):
      vec2(mix(1.0,atmosphere_height()-1.0,uv.y),uv.x*2.0-1.0);
  const float altitude=parameters.x;
  const float cosine_angle=parameters.y;
  const vec3 origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 direction=normalize(vec3(sqrt(max(0.0,1.0-
      cosine_angle*cosine_angle)),cosine_angle,0.0));
  float begin,end;
  vec3 value=vec3(1.0);
  if(medium_segment(origin,direction,begin,end))
    value=integrate_transmittance(origin+direction*begin,direction,end-begin,32);
  imageStore(transmittance_lut,coordinate,checked_lut_value(value,1.0));
}

void generate_multiple_scattering(ivec2 coordinate) {
  const ivec2 size=imageSize(multiple_scattering_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  const float altitude=mix(1.0,atmosphere_height()-1.0,uv.y);
  const float sun_cosine=uv.x*2.0-1.0;
  const vec3 origin=vec3(0.0,ground_radius()+altitude,0.0);
  const vec3 sun_direction=normalize(vec3(
      sqrt(max(0.0,1.0-sun_cosine*sun_cosine)),sun_cosine,0.0));
  vec3 incoming=vec3(0.0);
  vec3 transfer=vec3(0.0);
  const int direction_count=faithful_transport()?64:8;
  for(int direction_index=0;direction_index<64;++direction_index){
    if(direction_index>=direction_count)break;
    const float y=1.0-2.0*(float(direction_index)+0.5)/
        float(direction_count);
    const float angle=float(direction_index)*2.39996323;
    const vec3 direction=vec3(sqrt(max(0.0,1.0-y*y))*cos(angle),y,
                              sqrt(max(0.0,1.0-y*y))*sin(angle));
    float begin,end;
    if(!medium_segment(origin,direction,begin,end))continue;
    const int steps=faithful_transport()?20:6;
    const float step_length=(end-begin)/float(steps);
    vec3 view_transmittance=vec3(1.0);
    for(int step=0;step<steps;++step){
      const vec3 point=origin+direction*(begin+(float(step)+0.5)*step_length);
      const vec3 density=densities(length(point)-ground_radius());
      const vec3 local_extinction=extinction(density);
      const vec3 segment_transmittance=exp(-local_extinction*step_length);
      const vec3 scattering=atmosphere.rayleigh_ground_radius.rgb*density.x+
          atmosphere.mie_scattering_top_radius.rgb*density.y;
      const vec3 unit_illuminance=faithful_transport()?vec3(1.0):
          atmosphere.solar_absorption_peak.rgb;
      const vec3 source=scattering*lookup_transmittance(point,sun_direction)*
          unit_illuminance/(4.0*PI);
      const vec3 integral=(vec3(1.0)-segment_transmittance)/
          max(local_extinction,vec3(1.0e-9));
      incoming+=view_transmittance*source*integral;
      if(faithful_transport())
        transfer+=view_transmittance*scattering*integral;
      view_transmittance*=segment_transmittance;
    }
    if(faithful_transport()){
      const vec3 endpoint=origin+direction*end;
      if(length(endpoint)<=ground_radius()+5.0){
        const vec3 normal=normalize(endpoint);
        const float n_dot_l=max(dot(normal,sun_direction),0.0);
        const vec3 reflected=atmosphere.ground_albedo_mie_anisotropy.rgb*
            lookup_transmittance(endpoint+normal,sun_direction)*n_dot_l/PI;
        incoming+=view_transmittance*reflected;
      }
    }
  }
  incoming/=float(direction_count);
  transfer/=float(direction_count);
  if(faithful_transport()){
    // Hillaire 2020, equations 7-10: integrate the unitless local transfer
    // f_ms independently from second-order light, then close all remaining
    // isotropic orders as a bounded geometric series.
    const vec3 f_ms=clamp(transfer,vec3(0.0),vec3(0.999));
    incoming*=vec3(1.0)/max(vec3(1.0)-f_ms,vec3(1.0e-3));
  }
  // Preserve average incident radiance directly. Storing the much smaller
  // scattering*incoming source in RGBA16F loses dusk illumination precision;
  // lookup_multiple_scattering reconstructs that source where it is needed.
  imageStore(multiple_scattering_lut,coordinate,
             checked_lut_value(incoming,65504.0));
}

void generate_sky_view(ivec2 coordinate) {
  const ivec2 size=imageSize(sky_view_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate)+0.5)/vec2(size);
  const vec3 direction=view_direction(uv);
  vec3 transmittance;
  vec3 radiance=integrate_scattering(atmosphere.camera_position_near.xyz,
      direction,1.0e9,transmittance);
  imageStore(sky_view_lut,coordinate,checked_lut_value(radiance,65504.0));
}

void generate_aerial(ivec3 coordinate) {
  const ivec3 size=imageSize(aerial_scattering_lut);
  if(any(greaterThanEqual(coordinate,size)))return;
  const vec2 uv=(vec2(coordinate.xy)+0.5)/vec2(size.xy);
  const float slice=float(coordinate.z)/float(max(size.z-1,1));
  const float distance=slice*slice*slice*
      atmosphere.camera_forward_maximum_distance.w;
  vec3 transmittance;
  const vec3 radiance=integrate_scattering(
      atmosphere.camera_position_near.xyz,view_direction(uv),distance,
      transmittance);
  imageStore(aerial_scattering_lut,coordinate,
             checked_lut_value(radiance,65504.0));
  imageStore(aerial_transmittance_lut,coordinate,
             checked_lut_value(transmittance,1.0));
}

void main() {
  if(dispatch_mode.mode==0U)generate_transmittance(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==1U)
    generate_multiple_scattering(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==2U)generate_sky_view(ivec2(gl_GlobalInvocationID.xy));
  else if(dispatch_mode.mode==3U)generate_aerial(ivec3(gl_GlobalInvocationID));
}
