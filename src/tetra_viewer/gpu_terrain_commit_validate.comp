#version 450
// P8a validates a completed candidate entirely on-device.  A failed candidate
// leaves the already published private front and its indirect arguments intact.
layout(std430,binding=0) readonly buffer Source { uint words[]; } source;
layout(std430,binding=1) buffer Control { uint words[]; } control;
layout(push_constant) uniform Parameters { uint vertex_capacity; } parameters;
layout(local_size_x=1) in;
void main(){
  if(gl_GlobalInvocationID.x!=0u)return;
  control.words[0u]=0u;control.words[1u]=0u;
  const uint count=source.words[0u];
  const uint triangles=source.words[2u];
  if(source.words[1u]!=0u||count==0u||count>parameters.vertex_capacity||
     count%3u!=0u||triangles>parameters.vertex_capacity/12u||
     triangles*12u!=count)return;
  control.words[0u]=count;control.words[1u]=1u;
}
