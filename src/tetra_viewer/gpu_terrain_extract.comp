#version 450

// Immutable `GpuTerrainCellRecord`: four vec4(position_relative_world,
// signed_distance) values. Output starts with VkDrawIndexedIndirectCommand
// (five words), followed by an overflow word. Vertices are packed as the
// existing 18-float SceneVertex layout.
layout(std430,binding=0) readonly buffer Cells { vec4 cells[]; } input_cells;
layout(std430,binding=1) buffer Output { uint header[8]; float vertices[]; } output_surface;
layout(std430,binding=2) buffer Indices { uint indices[]; } output_indices;
layout(push_constant) uniform Parameters { uint cell_count; uint vertex_capacity; uint index_capacity; } parameters;
layout(local_size_x=64) in;

const ivec2 edges[6]=ivec2[6](ivec2(0,1),ivec2(0,2),ivec2(0,3),
                               ivec2(1,2),ivec2(1,3),ivec2(2,3));
void put_vertex(uint index,vec3 position,vec3 normal,vec3 barycentric){
  uint base=index*18u;
  output_surface.vertices[base+0u]=position.x;
  output_surface.vertices[base+1u]=position.y;
  output_surface.vertices[base+2u]=position.z;
  output_surface.vertices[base+3u]=0.46;
  output_surface.vertices[base+4u]=0.40;
  output_surface.vertices[base+5u]=0.31;
  output_surface.vertices[base+6u]=normal.x;
  output_surface.vertices[base+7u]=normal.y;
  output_surface.vertices[base+8u]=normal.z;
  output_surface.vertices[base+9u]=0.0;output_surface.vertices[base+10u]=0.0;
  output_surface.vertices[base+11u]=1.0;
  output_surface.vertices[base+12u]=barycentric.x;
  output_surface.vertices[base+13u]=barycentric.y;
  output_surface.vertices[base+14u]=barycentric.z;
  output_surface.vertices[base+15u]=normal.x;
  output_surface.vertices[base+16u]=normal.y;
  output_surface.vertices[base+17u]=normal.z;
}
void main(){
  uint cell=gl_GlobalInvocationID.x;
  if(cell>=parameters.cell_count)return;
  vec4 corners[4];for(uint i=0u;i<4u;++i)corners[i]=input_cells.cells[cell*4u+i];
  vec3 hits[4];uint count=0u;
  for(uint edge=0u;edge<6u;++edge){
    ivec2 e=edges[edge];float a=corners[e.x].w,b=corners[e.y].w;
    if((a<=0.0)==(b<=0.0))continue;
    float t=clamp(a/(a-b),0.0,1.0);
    hits[count++]=mix(corners[e.x].xyz,corners[e.y].xyz,t);
  }
  if(count<3u)return;
  uint emitted=count==3u?3u:6u;
  // Diagnostic-only execution witness.  It distinguishes an empty source
  // from a failed reservation/write path without being used for rendering.
  atomicAdd(output_surface.header[6],emitted);
  // A plain atomicAdd can leave the indirect vertexCount larger than the
  // backing allocation after overflow.  Reserve only when the whole patch
  // fits, so the header always remains safe for a future vkCmdDrawIndirect.
  uint first=0u;
  for(;;){
    uint observed=output_surface.header[0];
    if(observed>parameters.vertex_capacity-emitted ||
       observed>parameters.index_capacity-emitted){
      atomicOr(output_surface.header[5],1u);
      return;
    }
    uint previous=atomicCompSwap(output_surface.header[0],observed,
                                 observed+emitted);
    if(previous==observed){first=observed;break;}
  }
  output_surface.header[1]=1u;
  vec3 normal=normalize(cross(hits[1]-hits[0],hits[2]-hits[0]));
  put_vertex(first,hits[0],normal,vec3(1,0,0));
  put_vertex(first+1u,hits[1],normal,vec3(0,1,0));
  put_vertex(first+2u,hits[2],normal,vec3(0,0,1));
  output_indices.indices[first]=first;
  output_indices.indices[first+1u]=first+1u;
  output_indices.indices[first+2u]=first+2u;
  if(count==4u){
    put_vertex(first+3u,hits[0],normal,vec3(1,0,0));
    put_vertex(first+4u,hits[2],normal,vec3(0,1,0));
    put_vertex(first+5u,hits[3],normal,vec3(0,0,1));
    output_indices.indices[first+3u]=first+3u;
    output_indices.indices[first+4u]=first+4u;
    output_indices.indices[first+5u]=first+5u;
  }
}
