#version 450

// Immutable `GpuTerrainCellRecord`: four vec4(position_relative_world,
// cached_sign) values followed by exact roots, CPU-wound roots, and projected
// subdivision-midpoint vec4 values, and CPU-oriented child normals.
// Output starts with VkDrawIndexedIndirectCommand
// (five words), followed by an overflow word. Vertices are packed as the
// existing 18-float SceneVertex layout.
layout(std430,binding=0) readonly buffer Cells { vec4 cells[]; } input_cells;
layout(std430,binding=1) buffer Output { uint header[8]; float vertices[]; } output_surface;
layout(std430,binding=2) buffer Indices { uint indices[]; } output_indices;
layout(push_constant) uniform Parameters { uint cell_count; uint vertex_capacity; uint index_capacity; uint subdivide_triangles; } parameters;
layout(local_size_x=64) in;

const ivec2 edges[6]=ivec2[6](ivec2(0,1),ivec2(0,2),ivec2(0,3),
                               ivec2(1,2),ivec2(1,3),ivec2(2,3));
void put_vertex(uint index,vec3 position,vec3 normal,vec3 barycentric){
  uint base=index*18u;
  output_surface.vertices[base+0u]=position.x;
  output_surface.vertices[base+1u]=position.y;
  output_surface.vertices[base+2u]=position.z;
  output_surface.vertices[base+3u]=0.46;
  output_surface.vertices[base+4u]=0.40;
  output_surface.vertices[base+5u]=0.31;
  output_surface.vertices[base+6u]=normal.x;
  output_surface.vertices[base+7u]=normal.y;
  output_surface.vertices[base+8u]=normal.z;
  output_surface.vertices[base+9u]=0.0;output_surface.vertices[base+10u]=0.0;
  output_surface.vertices[base+11u]=1.0;
  output_surface.vertices[base+12u]=barycentric.x;
  output_surface.vertices[base+13u]=barycentric.y;
  output_surface.vertices[base+14u]=barycentric.z;
  output_surface.vertices[base+15u]=normal.x;
  output_surface.vertices[base+16u]=normal.y;
  output_surface.vertices[base+17u]=normal.z;
}
void put_triangle(uint first,vec3 a,vec3 b,vec3 c,vec3 normal){
  put_vertex(first,a,normal,vec3(1,0,0));
  put_vertex(first+1u,b,normal,vec3(0,1,0));
  put_vertex(first+2u,c,normal,vec3(0,0,1));
  output_indices.indices[first]=first;
  output_indices.indices[first+1u]=first+1u;
  output_indices.indices[first+2u]=first+2u;
}
void put_subdivided_triangle(uint first,vec3 a,vec3 b,vec3 c,
                             vec3 ab,vec3 bc,vec3 ca,vec3 normals[4]){
  if(parameters.subdivide_triangles==0u){
    put_triangle(first,a,b,c,normals[0]);return;
  }
  // CPU supplies field-projected midpoints using the same half-footprint
  // convention as its visible planetary draw path.
  put_triangle(first,a,ab,ca,normals[0]);
  put_triangle(first+3u,ab,b,bc,normals[1]);
  put_triangle(first+6u,ca,bc,c,normals[2]);
  put_triangle(first+9u,ab,bc,ca,normals[3]);
}
void main(){
  uint cell=gl_GlobalInvocationID.x;
  if(cell>=parameters.cell_count)return;
  // Twenty-eight vec4 values: corners, roots, wound roots, midpoints, normals.
  const uint cell_base=cell*28u;
  vec4 corners[4];for(uint i=0u;i<4u;++i)corners[i]=input_cells.cells[cell_base+i];
  vec3 hits[4];uint count=0u;
  for(uint edge=0u;edge<6u;++edge){
    ivec2 e=edges[edge];float a=corners[e.x].w,b=corners[e.y].w;
    if((a<=0.0)==(b<=0.0))continue;
    const vec4 root=input_cells.cells[cell_base+4u+edge];
    if(root.w!=1.0) { atomicOr(output_surface.header[5],1u); return; }
    hits[count++]=root.xyz;
  }
  if(count<3u)return;
  const uint triangle_mask=uint(input_cells.cells[cell_base+13u].w);
  const uint allowed_mask=count==3u?1u:3u;
  if(triangle_mask==0u||(triangle_mask&~allowed_mask)!=0u){
    atomicOr(output_surface.header[5],1u);return;
  }
  uint emitted=bitCount(triangle_mask)*3u*
      (parameters.subdivide_triangles==0u?1u:4u);
  // Diagnostic-only execution witness.  It distinguishes an empty source
  // from a failed reservation/write path without being used for rendering.
  atomicAdd(output_surface.header[6],emitted);
  // A plain atomicAdd can leave the indirect vertexCount larger than the
  // backing allocation after overflow.  Reserve only when the whole patch
  // fits, so the header always remains safe for a future vkCmdDrawIndirect.
  uint first=0u;
  for(;;){
    uint observed=output_surface.header[0];
    if(observed>parameters.vertex_capacity-emitted ||
       observed>parameters.index_capacity-emitted){
      atomicOr(output_surface.header[5],1u);
      return;
    }
    uint previous=atomicCompSwap(output_surface.header[0],observed,
                                 observed+emitted);
    if(previous==observed){first=observed;break;}
  }
  output_surface.header[1]=1u;
  vec4 draw_roots[4];for(uint i=0u;i<4u;++i)
    draw_roots[i]=input_cells.cells[cell_base+10u+i];
  for(uint i=0u;i<min(count,3u);++i)if(draw_roots[i].w!=1.0){
    atomicOr(output_surface.header[5],1u);return;
  }
  vec4 midpoints[6];for(uint i=0u;i<6u;++i)
    midpoints[i]=input_cells.cells[cell_base+14u+i];
  vec4 supplied_normals[8];for(uint i=0u;i<8u;++i)
    supplied_normals[i]=input_cells.cells[cell_base+20u+i];
  uint stride=parameters.subdivide_triangles==0u?3u:12u;
  uint cursor=first;
  if((triangle_mask&1u)!=0u){
    vec3 normals[4]=vec3[4](supplied_normals[0].xyz,supplied_normals[1].xyz,
                             supplied_normals[2].xyz,supplied_normals[3].xyz);
    put_subdivided_triangle(cursor,draw_roots[0].xyz,draw_roots[1].xyz,
                            draw_roots[2].xyz,midpoints[0].xyz,
                            midpoints[1].xyz,midpoints[2].xyz,normals);
    cursor+=stride;
  }
  if((triangle_mask&2u)!=0u){
    vec3 normals[4]=vec3[4](supplied_normals[4].xyz,supplied_normals[5].xyz,
                             supplied_normals[6].xyz,supplied_normals[7].xyz);
    put_subdivided_triangle(cursor,draw_roots[0].xyz,
                            draw_roots[2].xyz,draw_roots[3].xyz,
                            midpoints[3].xyz,midpoints[4].xyz,
                            midpoints[5].xyz,normals);
  }
}
