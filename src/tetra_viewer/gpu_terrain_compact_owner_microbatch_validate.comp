#version 450

// P7e4d validation gate. It owns the microbatch copy grid: every rejection
// clears it before retained-front copy can be encoded.
layout(std430,binding=0) readonly buffer Source {uint words[];} source;
layout(std430,binding=1) buffer Status {uint words[];} status;
layout(std430,binding=2) buffer CopyDispatch {uint words[];} copy_dispatch;
layout(push_constant) uniform Parameters {uint vertex_capacity;} P;
layout(local_size_x=1) in;
void main(){if(gl_GlobalInvocationID.x!=0u)return;
  status.words[0u]=0u;
  copy_dispatch.words[0u]=0u;copy_dispatch.words[1u]=1u;
  copy_dispatch.words[2u]=1u;copy_dispatch.words[3u]=0u;
  if(status.words[1u]!=0u||source.words[1u]!=0u||source.words[0u]==0u||
     source.words[0u]>P.vertex_capacity||source.words[0u]%3u!=0u||
     source.words[2u]>P.vertex_capacity/12u||
     source.words[2u]*12u!=source.words[0u]){status.words[1u]=1u;return;}
  status.words[0u]=1u;
  copy_dispatch.words[0u]=(source.words[0u]*18u+255u)/256u;
}
