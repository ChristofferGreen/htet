uint bit(uvec2 p,uint i){return i<64u?(p.x>>i)&1u:(p.y>>(i-64u))&1u;}
uint digit(uvec2 p,uint d,uint i){uint b=3u*(d-i-1u);return bit(p,b)|(bit(p,b+1u)<<1u)|(bit(p,b+2u)<<2u);}
vec3 root_vertex(uint r,uint c){const uint t[48]=uint[48](0,2,3,8,0,3,1,8,4,5,7,8,4,7,6,8,0,1,5,8,0,5,4,8,2,6,7,8,2,7,3,8,0,4,6,8,0,6,2,8,1,3,7,8,1,7,5,8);const vec3 v[9]=vec3[9](vec3(0),vec3(2,0,0),vec3(0,2,0),vec3(2,2,0),vec3(0,0,2),vec3(2,0,2),vec3(0,2,2),vec3(2,2,2),vec3(1));return v[t[r*4u+c]]*.5;}
bool reconstruct(uint owner,out vec3 g[4]){uint b=owner*12u,h=owners.words[b+1u],r=(h>>26u)&63u,d=(h>>20u)&63u;if(r>=12u||d>38u)return false;for(uint i=0u;i<4u;++i)g[i]=root_vertex(r,i);uvec2 p=uvec2(owners.words[b+2u],owners.words[b+3u]);for(uint l=0u;l<d;++l){vec3 m[6];for(uint e=0u;e<6u;++e)m[e]=.5*(g[E[e].x]+g[E[e].y]);vec3 a[4];for(uint i=0u;i<4u;++i)a[i]=g[i];uint x=digit(p,d,l);if(x==0u){g[0]=a[0];g[1]=m[0];g[2]=m[1];g[3]=m[2];}else if(x==1u){g[0]=a[1];g[1]=m[0];g[2]=m[3];g[3]=m[4];}else if(x==2u){g[0]=a[2];g[1]=m[1];g[2]=m[3];g[3]=m[5];}else if(x==3u){g[0]=a[3];g[1]=m[2];g[2]=m[4];g[3]=m[5];}else{uint q=x-4u;const uint A[3]=uint[3](0,1,2),Z[3]=uint[3](5,4,3),H[12]=uint[12](1,2,4,3,0,2,5,3,0,1,5,4);uint k=0u;float x0=dot(m[5]-m[0],m[5]-m[0]),x1=dot(m[4]-m[1],m[4]-m[1]),x2=dot(m[3]-m[2],m[3]-m[2]);if(x1<x0)k=1u;if(x2<(k==0u?x0:x1))k=2u;g[0]=m[A[k]];g[1]=m[H[k*4u+q]];g[2]=m[H[k*4u+((q+1u)&3u)]];g[3]=m[Z[k]];}}return true;}
vec3 root(vec3 a,vec3 b){float fa=terrain_field_signed_distance(a,lane(1u,3u));for(uint i=0u;i<20u;++i){vec3 m=.5*(a+b);if((fa<0.0)==(terrain_field_signed_distance(m,lane(1u,3u))<0.0)){a=m;fa=terrain_field_signed_distance(m,lane(1u,3u));}else b=m;}return .5*(a+b)*lane(9u,3u)+vec3(lane(9u,0u),lane(9u,1u),lane(9u,2u));}
vec3 project_midpoint(vec3 point,out vec3 smooth_normal){bool evaluated=false;for(int iteration=0;iteration<4;++iteration){const float distance=terrain_field_signed_distance_world(point,lane(1u,3u)*.5);if(abs(distance)<1.e-10)break;smooth_normal=terrain_field_normal_world(point,lane(1u,3u)*.5);evaluated=true;point-=smooth_normal*distance;}if(!evaluated)smooth_normal=terrain_field_normal_world(point,lane(1u,3u)*.5);return point;}
void vertex(uint n,vec3 p,vec3 normal_value,vec3 smooth_normal,uint c){uint d=4u+n*18u;outv.words[d]=floatBitsToUint(p.x);outv.words[d+1u]=floatBitsToUint(p.y);outv.words[d+2u]=floatBitsToUint(p.z);outv.words[d+3u]=floatBitsToUint(.43);outv.words[d+4u]=floatBitsToUint(.45);outv.words[d+5u]=floatBitsToUint(.47);outv.words[d+6u]=floatBitsToUint(normal_value.x);outv.words[d+7u]=floatBitsToUint(normal_value.y);outv.words[d+8u]=floatBitsToUint(normal_value.z);outv.words[d+9u]=floatBitsToUint(-2.0);outv.words[d+10u]=0u;outv.words[d+11u]=floatBitsToUint(7.0);outv.words[d+12u]=floatBitsToUint(c==0u?1.:0.);outv.words[d+13u]=floatBitsToUint(c==1u?1.:0.);outv.words[d+14u]=floatBitsToUint(c==2u?1.:0.);outv.words[d+15u]=floatBitsToUint(smooth_normal.x);outv.words[d+16u]=floatBitsToUint(smooth_normal.y);outv.words[d+17u]=floatBitsToUint(smooth_normal.z);}
uint triangles_for_sign(uint s){uint crossing_count=0u;for(uint edge=0u;edge<6u;++edge)crossing_count+=((s>>E[edge].x)&1u)!=((s>>E[edge].y)&1u)?1u:0u;return crossing_count==3u?1u:crossing_count==4u?2u:0u;}
void main(){const uint triangle=gl_GlobalInvocationID.x;if(triangle>=outv.words[2u]||outv.words[1u]!=0u)return;const uint owner_count=owner_header.words[0u];if(owner_count==0u||owner_count>1024u||owner_header.words[2u]!=0u||owner_header.words[3u]!=1u){atomicOr(outv.words[1u],1u);return;}uint lo=0u,hi=owner_count;while(lo<hi){const uint mid=lo+(hi-lo)/2u;if(offsets.values[mid]<=triangle)lo=mid+1u;else hi=mid;}if(lo==0u){atomicOr(outv.words[1u],2u);return;}const uint owner=lo-1u;uint local_triangle=triangle-offsets.values[owner];if(local_triangle>=counts.values[owner]){atomicOr(outv.words[1u],2u);return;}vec3 g[4];const uint mask=owners.words[owner*12u+10u];if(!reconstruct(owner,g)||mask>=64u){atomicOr(outv.words[1u],4u);return;}vec3 m[6];for(uint e=0u;e<6u;++e)m[e]=.5*(g[E[e].x]+g[E[e].y]);const vec3 p[10]=vec3[10](m[2],m[1],m[0],g[0],m[4],m[3],g[1],m[5],g[2],g[3]);const uint cells=templates.words[mask*28u+24u];uint cell=cells,sign=0u,cut=0u;for(uint c=0u;c<cells;++c){const uint s=(signs.values[owner*3u+c/8u]>>((c&7u)*4u))&15u;const uint triangle_count=triangles_for_sign(s);if(local_triangle<triangle_count){cell=c;sign=s;cut=local_triangle;break;}local_triangle-=triangle_count;}if(cell==cells){atomicOr(outv.words[1u],8u);return;}const uint packed=templates.words[mask*28u+cell];uint ix[4];for(uint k=0u;k<4u;++k){ix[k]=(packed>>(8u*k))&255u;if(ix[k]>=10u){atomicOr(outv.words[1u],16u);return;}}const uvec3 ce=CUT[sign*2u+cut];vec3 q[6];q[ce.x]=root(p[ix[E[ce.x].x]],p[ix[E[ce.x].y]]);q[ce.y]=root(p[ix[E[ce.y].x]],p[ix[E[ce.y].y]]);q[ce.z]=root(p[ix[E[ce.z].x]],p[ix[E[ce.z].y]]);vec3 a=q[ce.x],b=q[ce.y],c=q[ce.z],sn[6];vec3 ab=project_midpoint((a+b)*.5,sn[1])-P.origin.xyz,bc=project_midpoint((b+c)*.5,sn[4])-P.origin.xyz,ca=project_midpoint((c+a)*.5,sn[2])-P.origin.xyz;const vec3 pts[6]=vec3[6](a-P.origin.xyz,ab,ca,b-P.origin.xyz,bc,c-P.origin.xyz);sn[0]=terrain_field_normal_world(a,lane(1u,3u));sn[3]=terrain_field_normal_world(b,lane(1u,3u));sn[5]=terrain_field_normal_world(c,lane(1u,3u));const uvec3 f[4]=uvec3[4](uvec3(0,1,2),uvec3(1,3,4),uvec3(2,4,5),uvec3(1,4,2));for(uint face=0u;face<4u;++face){const vec3 cross_value=cross(pts[f[face].y]-pts[f[face].x],pts[f[face].z]-pts[f[face].x]);const float cross_length=dot(cross_value,cross_value);const vec3 normal_value=cross_length>1.e-20?normalize(cross_value):sn[f[face].x];if(!finite3(normal_value)){atomicOr(outv.words[1u],32u);return;}const uint base=triangle*12u+face*3u;for(uint corner=0u;corner<3u;++corner)vertex(base+corner,pts[f[face][corner]],normal_value,sn[f[face][corner]],corner);}}
