float lane(uint i,uint c){return uintBitsToFloat(field.lanes[i][c]);}
bool finite(float x){return !isnan(x)&&!isinf(x);} bool finite3(vec3 x){return finite(x.x)&&finite(x.y)&&finite(x.z);}
