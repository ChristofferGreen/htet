// baseInstance.  Do not touch the old arguments unless all candidate checks won.
layout(std430,binding=0) readonly buffer Control { uint words[]; } control;
layout(std430,binding=1) buffer Arguments { uint words[]; } arguments;
layout(local_size_x=1) in;
void main(){
  if(gl_GlobalInvocationID.x!=0u||control.words[1u]==0u)return;
